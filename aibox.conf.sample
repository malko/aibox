# AIBox Configuration File
# This file stores settings for the setup script.
# Values can be edited manually or will be updated automatically after each run.
#
# Usage:
#   ./setup.sh -c path/to/this/file
#
# Boolean values: "yes" or "no"

# VM Configuration
VM_NAME="aibox"
GUEST_USER="aibox"

# Create VM if it doesn't exist
CREATE_VM="yes"

# Security
DISABLE_PASSWORD_AUTH="yes"

# Installation Options
INSTALL_DEPS="yes"
CONFIGURE_GIT="yes"
CONFIGURE_MOTD="yes"
INSTALL_DOCKER="yes"
INSTALL_NPM="yes"

# dsh (DeepSeek Harness) web service
INSTALL_DSH="no"
# DSH_PORT="3080"

# Claude Code CLI
INSTALL_CLAUDE="yes"

# Automatic update check (boot + daily, shown in the MOTD)
INSTALL_UPDATE_CHECK="yes"

# Virtiofs (git share with host)
CONFIGURE_VIRTIOFS="no"
# HOST_SHARE_DIR="$HOME/git"

# Tunnel service (exposes VM services on the host)
# TUNNEL_BIND="local"          # "local" (127.0.0.1) or "lan" (0.0.0.0)
# TUNNEL_LAN_TIMEOUT="2h"      # default auto-revert delay for 'tunnel lan on'
# TUNNEL_WAIT="120"            # seconds the tunnel waits for the VM
