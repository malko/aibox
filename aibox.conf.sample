# AIBox Configuration File
# This file stores settings for the setup script.
# Values can be edited manually or will be updated automatically after each run.
#
# Usage:
#   ./setup.sh -c path/to/this/file
#
# Boolean values: "yes" or "no"

# VM Configuration
VM_NAME="aibox"
GUEST_USER="aibox"

# VM backend: "auto" (libvirt on Linux, Lima on macOS), "libvirt" or "lima"
# VM_BACKEND="auto"

# Create VM if it doesn't exist
CREATE_VM="yes"

# Security
DISABLE_PASSWORD_AUTH="yes"

# Installation Options
INSTALL_DEPS="yes"
CONFIGURE_GIT="yes"
CONFIGURE_MOTD="yes"
INSTALL_DOCKER="yes"
INSTALL_NPM="yes"

# dsh (DeepSeek Harness) web service
INSTALL_DSH="no"
# DSH_PORT="3080"

# Claude Code CLI
INSTALL_CLAUDE="yes"

# Automatic update check (boot + daily, shown in the MOTD)
INSTALL_UPDATE_CHECK="yes"

# Virtiofs (git share with host)
CONFIGURE_VIRTIOFS="no"
# HOST_SHARE_DIR="$HOME/git"

# Tunnel service (exposes VM services on the host)
# LAN exposure is configured per service:
#   aibox tunnel lan on opencode --permanent   # survives reboot
#   aibox tunnel lan on dsh --timeout 30m      # temporary
# TUNNEL_LAN_TIMEOUT="2h"      # default auto-revert delay for temporary exposure
# TUNNEL_WAIT="120"            # seconds the tunnel waits for the VM

# Hostname used in LAN service URLs. Empty/absent = automatic (hostname.local).
# LAN_HOSTNAME="desk.local"

# Local web interface (aibox web).
# WEB_PORT="8787"
