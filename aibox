#!/bin/bash

# Resolve symlinks to get actual script location
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SCRIPT_SOURCE="$(readlink -f "$SCRIPT_SOURCE")"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
CMD_DIR="$SCRIPT_DIR/cmd"

# Global options
CONFIG_FILE=""
NO_SERVICE=false
LAN_EXPOSE=false
POSITIONAL_ARGS=()

usage() {
    echo "Usage: aibox [options] [service] [host_port:guest_port] [port] ..."
    echo ""
    echo "Commands:"
    echo "  start                             Start the VM and the tunnel service"
    echo "  status                            VM state, service URLs and tunnel state"
    echo "  exec [-t] [--] <cmd> [args]       Run a command in the VM (SSH, for scripting)"
    echo "  tunnel <command>                  Manage the tunnel and per-service LAN exposure"
    echo "  vscode [dir]                      Open the local VS Code on the VM (Remote-SSH)"
    echo "  service-add <name> <port> [--lan] Add a service (--lan = permanent LAN exposure)"
    echo "  service-edit <name> [options]     Edit or rename a service"
    echo "  service-remove <name>             Remove a service"
    echo "  service-list                      List services and their LAN exposure"
    echo "  web [--port N] [--no-open]        Launch the local web interface"
    echo "  config get|set|list               Read or update aibox.conf"
    echo "  setup [step ...]                  Run setup steps (see 'aibox setup --help')"
    echo "  update <target>                   Update (opencode, opencode-service, dsh, claude, os, scripts, vscode-server, all)"
    echo "  check-updates                     Check for available updates (host + VM)"
    echo "  self-update                       Pull the aibox repo and push scripts to the VM"
    echo "  shutdown [-f]                     Stop tunnel + shutdown VM (use -f to force)"
    echo "  restart [-f]                      Restart VM (tunnel reconnects automatically)"
    echo "  snapshot create [name]            Create snapshot"
    echo "  snapshot list                     List snapshots"
    echo "  snapshot delete <name>            Delete snapshot"
    echo "  snapshot revert <name>            Revert to snapshot"
    echo "  help [command]                    Show general help or a command's help"
    echo ""
    echo "Examples:"
    echo "  aibox                                Connect and open a shell"
    echo "  aibox start                          Start VM + tunnel without connecting"
    echo "  aibox status                         Show VM, URLs and tunnel state"
    echo "  aibox web                            Open the local web interface"
    echo "  aibox tunnel lan on opencode --permanent   Permanently expose opencode"
    echo "  aibox tunnel lan on dsh --timeout 30m      Temporary LAN exposure"
    echo "  aibox tunnel lan off opencode        Back to localhost for one service"
    echo "  aibox -c /path/to/config.conf        Use custom config file"
    echo "  aibox service-add opencode 4096      Add opencode service"
    echo "  aibox service-add portainer 8080:9000 --lan"
    echo "  aibox help service-add               Show help for service-add"
    echo "  aibox setup motd                     Reconfigure the MOTD only"
    echo "  aibox update opencode                Update and restart opencode"
    echo "  aibox update scripts                 Upload scripts to VM"
    echo "  aibox shutdown                       Gracefully shutdown VM"
    echo "  aibox restart                        Restart VM"
    echo "  aibox snapshot create                Create snapshot with auto name"
    echo ""
    echo "Options:"
    echo "  -c, --config FILE    Path to config file (default: ~/.config/aibox/aibox.conf)"
    echo "  -n, --no-service     Start without SSH tunnels (no port forwarding)"
    echo "      --lan            Bind ad-hoc forwarded ports on the LAN (0.0.0.0)"
    echo "  -h, --help           Show this help"
    echo "  --completion [shell] Output shell completion script (bash or zsh)"
    exit 0
}

help_command() {
    local command="$1" script=""

    case "$command" in
        setup)
            "$SCRIPT_DIR/setup.sh" --help
            return $?
            ;;
        help)
            echo "Usage: aibox help [command]"
            echo ""
            echo "Show general help, or the dedicated help for one command."
            return 0
            ;;
        update)
            script="$CMD_DIR/update-target"
            ;;
        shutdown)
            script="$CMD_DIR/vm-shutdown"
            ;;
        restart)
            script="$CMD_DIR/vm-restart"
            ;;
        snapshot)
            script="$CMD_DIR/vm-snapshot"
            ;;
        start|status|exec|vscode|tunnel|service-add|service-edit|service-remove|service-list|web|config|check-updates|self-update)
            script="$CMD_DIR/$command"
            ;;
        "")
            usage
            ;;
        *)
            echo "Error: no help for unknown command '$command'." >&2
            echo "Run 'aibox --help' for the command list." >&2
            return 1
            ;;
    esac

    if [[ -x "$script" ]]; then
        "$script" --help
    else
        echo "Error: command script not found: $script" >&2
        return 1
    fi
}

completion() {
    # Detect shell if not specified
    local shell="${1:-}"
    [[ -z "$shell" ]] && shell="bash"

    if [[ "$shell" == "zsh" ]]; then
        cat << 'ZEOF'
#compdef aibox

_aibox_services() {
    local -a services
    services=(${(f)"$(jq -r 'keys[]' "$HOME/.config/aibox/services.json" 2>/dev/null)"})
    services=(${services:#})
    (( ${#services} )) || return 0
    _describe 'service' services
}

_aibox_snapshots() {
    local -a snapshots
    snapshots=(${(f)"$(virsh snapshot-list aibox --name 2>/dev/null)"})
    snapshots=(${snapshots:#})
    (( ${#snapshots} )) || return 0
    _describe 'snapshot' snapshots
}

_aibox_setup_steps() {
    local -a steps
    steps=(${(f)"$(aibox --setup-steps 2>/dev/null)"})
    steps+=(all)
    _describe 'step' steps
}

_aibox_tunnel() {
    if (( CURRENT == 2 )); then
        _values 'tunnel command' start stop restart status logs install uninstall lan
        return
    fi

    case $words[2] in
        lan)
            if (( CURRENT == 3 )); then
                _values 'lan command' on off
                return
            fi
            case $words[3] in
                on)
                    _arguments \
                        '--permanent[persist LAN exposure]' \
                        '--timeout[temporary duration]:duration:(30m 1h 2h 0)' \
                        '--no-timeout[temporary until reboot]' \
                        '(-y --yes)'{-y,--yes}'[do not ask for confirmation]' \
                        '(-h --help)'{-h,--help}'[show help]' \
                        '*:service:_aibox_services'
                    ;;
                off)
                    _arguments \
                        '(-h --help)'{-h,--help}'[show help]' \
                        '*:service:_aibox_services'
                    ;;
            esac
            ;;
    esac
}

_aibox_snapshot() {
    if (( CURRENT == 2 )); then
        _values 'snapshot command' create list delete revert
        return
    fi

    case $words[2] in
        delete|revert)
            _arguments '*:snapshot:_aibox_snapshots'
            ;;
    esac
}

local -a commands
commands=(
  'start:start VM and tunnel'
  'status:show VM, URLs and tunnel state'
  'exec:run a command in the VM'
  'tunnel:manage the tunnel service'
  'vscode:open the local VS Code on the VM (Remote-SSH)'
  'service-add:add a service'
  'service-edit:edit or rename a service'
  'service-remove:remove a service'
  'service-list:list configured services'
  'web:launch the local web interface'
  'config:read or update aibox.conf'
  'setup:run setup steps'
  'update:update service or app (opencode, opencode-service, dsh, claude, os, scripts, vscode-server, all)'
  'check-updates:check for available updates (host + VM)'
  'self-update:pull the aibox repo and push scripts to the VM'
  'shutdown:shutdown VM'
  'restart:restart VM'
  'snapshot:manage snapshots'
  'help:show general or command help'
)

_arguments -C \
  '(-c --config)'{-c,--config}'[config file]:config file:_files' \
  '(-n --no-service)'{-n,--no-service}'[start without port forwarding]' \
  '--lan[bind ad-hoc ports on the LAN]' \
  '(-h --help)'{-h,--help}'[show help]' \
  '--completion[output completion script]:shell:(bash zsh)' \
  '1:command:->command' \
  '*::arg:->args'

case $state in
  command)
    _describe 'command' commands
    ;;
  args)
    case $words[1] in
      start|status|check-updates|self-update)
        _values 'flag' '-h' '--help'
        ;;
      exec)
        _command_names -e
        ;;
      tunnel)
        _aibox_tunnel
        ;;
      vscode)
        _files -/
        ;;
      service-add)
        _arguments \
          '--lan[expose permanently on the LAN]' \
          '(-y --yes)'{-y,--yes}'[do not ask for confirmation]' \
          '(-h --help)'{-h,--help}'[show help]' \
          '1:name:' \
          '2:port:'
        ;;
      service-edit)
        _arguments \
          '--name[new service name]:name:' \
          '--port[new port]:port:' \
          '--lan[expose permanently on the LAN]' \
          '--local[back to localhost]' \
          '(-h --help)'{-h,--help}'[show help]' \
          '1:service:_aibox_services'
        ;;
      service-remove)
        _arguments \
          '(-h --help)'{-h,--help}'[show help]' \
          '*:service:_aibox_services'
        ;;
      service-list)
        _values 'flag' '-h' '--help'
        ;;
      web)
        _arguments \
          '--port[listen port]:port:' \
          '--no-open[do not open the browser]' \
          '(-h --help)'{-h,--help}'[show help]'
        ;;
      config)
        _values 'config command' get set list
        ;;
      setup)
        _arguments \
          '(-c --config)'{-c,--config}'[config file]:config file:_files' \
          '(-h --help)'{-h,--help}'[show help]' \
          '*:step:_aibox_setup_steps'
        ;;
      update)
        _arguments \
          '(-y --yes)'{-y,--yes}'[non-interactive system upgrade]' \
          '(-h --help)'{-h,--help}'[show help]' \
          '*:target:(opencode opencode-service dsh claude os scripts vscode-server all)'
        ;;
      shutdown|restart)
        _values 'flag' '-f' '--force' '-h' '--help'
        ;;
      snapshot)
        _aibox_snapshot
        ;;
      help)
        _describe 'command' commands
        ;;
    esac
    ;;
esac
ZEOF
    else
        # Bash completion
        cat << 'BASHEOF'
_aibox_services() {
    jq -r 'keys[]' "$HOME/.config/aibox/services.json" 2>/dev/null
}

_aibox_snapshots() {
    virsh snapshot-list aibox --name 2>/dev/null
}

_aibox() {
    local cur prev cmd cmd_idx sub sub_idx lan_idx lan_sub i
    local opts="start status exec tunnel vscode service-add service-edit service-remove service-list web config setup update check-updates self-update shutdown restart snapshot help"
    local global_opts="-c --config -n --no-service --lan -h --help --completion"

    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    case "$prev" in
        -c|--config)
            COMPREPLY=($(compgen -f -- "$cur"))
            return 0
            ;;
        --completion)
            COMPREPLY=($(compgen -W "bash zsh" -- "$cur"))
            return 0
            ;;
        --timeout)
            COMPREPLY=($(compgen -W "30m 1h 2h 0" -- "$cur"))
            return 0
            ;;
    esac

    # Find the command, skipping global options and their values.
    cmd_idx=""
    i=1
    while [[ $i -lt $COMP_CWORD ]]; do
        case "${COMP_WORDS[i]}" in
            -c|--config|--completion)
                i=$((i + 2))
                ;;
            -*)
                i=$((i + 1))
                ;;
            *)
                cmd_idx=$i
                break
                ;;
        esac
    done

    if [[ -z "$cmd_idx" ]]; then
        COMPREPLY=($(compgen -W "$global_opts $opts" -- "$cur"))
        return 0
    fi

    cmd="${COMP_WORDS[cmd_idx]}"
    case " $opts " in
        *" $cmd "*) ;;
        *) return 0 ;;
    esac

    sub_idx=$((cmd_idx + 1))
    sub="${COMP_WORDS[sub_idx]:-}"

    case "$cmd" in
        tunnel)
            if [[ $COMP_CWORD -eq $sub_idx ]]; then
                COMPREPLY=($(compgen -W "start stop restart status logs install uninstall lan" -- "$cur"))
                return 0
            fi
            if [[ "$sub" == "lan" ]]; then
                lan_idx=$((cmd_idx + 2))
                lan_sub="${COMP_WORDS[lan_idx]:-}"
                if [[ $COMP_CWORD -eq $lan_idx ]]; then
                    COMPREPLY=($(compgen -W "on off" -- "$cur"))
                    return 0
                fi
                case "$lan_sub" in
                    on)
                        if [[ "$cur" == --timeout=* ]]; then
                            COMPREPLY=($(compgen -W "--timeout=30m --timeout=1h --timeout=2h --timeout=0" -- "$cur"))
                        elif [[ "$cur" == -* ]]; then
                            COMPREPLY=($(compgen -W "--permanent --timeout --no-timeout -y --yes -h --help" -- "$cur"))
                        else
                            COMPREPLY=($(compgen -W "$(_aibox_services)" -- "$cur"))
                        fi
                        ;;
                    off)
                        if [[ "$cur" == -* ]]; then
                            COMPREPLY=($(compgen -W "-h --help" -- "$cur"))
                        else
                            COMPREPLY=($(compgen -W "$(_aibox_services)" -- "$cur"))
                        fi
                        ;;
                esac
                return 0
            fi
            return 0
            ;;
        service-add)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--lan -y --yes -h --help" -- "$cur"))
            fi
            return 0
            ;;
        service-edit)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--name --port --lan --local -h --help" -- "$cur"))
            elif [[ $COMP_CWORD -eq $sub_idx ]]; then
                COMPREPLY=($(compgen -W "$(_aibox_services)" -- "$cur"))
            fi
            return 0
            ;;
        web)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--port --no-open -h --help" -- "$cur"))
            fi
            return 0
            ;;
        config)
            if [[ $COMP_CWORD -eq $sub_idx ]]; then
                COMPREPLY=($(compgen -W "get set list" -- "$cur"))
            fi
            return 0
            ;;
        service-remove)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "$(_aibox_services)" -- "$cur"))
            fi
            return 0
            ;;
        service-list|start|status|check-updates|self-update)
            COMPREPLY=($(compgen -W "-h --help" -- "$cur"))
            return 0
            ;;
        snapshot)
            if [[ $COMP_CWORD -eq $sub_idx ]]; then
                COMPREPLY=($(compgen -W "create list delete revert" -- "$cur"))
                return 0
            fi
            if [[ "$sub" == "delete" || "$sub" == "revert" ]]; then
                COMPREPLY=($(compgen -W "$(_aibox_snapshots)" -- "$cur"))
            fi
            return 0
            ;;
        setup)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-c --config -h --help" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "$(aibox --setup-steps 2>/dev/null) all" -- "$cur"))
            fi
            return 0
            ;;
        update)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-y --yes -h --help" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "opencode opencode-service dsh claude os scripts vscode-server all" -- "$cur"))
            fi
            return 0
            ;;
        shutdown|restart)
            COMPREPLY=($(compgen -W "-f --force -h --help" -- "$cur"))
            return 0
            ;;
        help)
            COMPREPLY=($(compgen -W "$opts" -- "$cur"))
            return 0
            ;;
        vscode)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-h --help" -- "$cur"))
            else
                COMPREPLY=($(compgen -d -- "$cur"))
            fi
            return 0
            ;;
        exec)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "-t --tty -T --no-tty -h --help" -- "$cur"))
            else
                COMPREPLY=($(compgen -c -- "$cur"))
            fi
            return 0
            ;;
        *)
            COMPREPLY=($(compgen -W "-h --help" -- "$cur"))
            return 0
            ;;
    esac
}

complete -F _aibox aibox
BASHEOF
    fi
}

# 'setup' relays its arguments verbatim to setup.sh (it has its own options).
if [[ "${1:-}" == "setup" ]]; then
    shift
    exec "$SCRIPT_DIR/setup.sh" "$@"
fi

# Service commands are dispatched before global option parsing so that
# 'service-add ... --lan' is not mistaken for the global ad-hoc --lan flag.
case "${1:-}" in
    service-add|service-edit|service-remove|service-list)
        COMMAND="$1"
        shift
        exec "$CMD_DIR/$COMMAND" "$@"
        ;;
esac

# --- Argument Parsing ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--config)
            if [[ $# -lt 2 || "$2" == -* ]]; then
                echo "Error: -c/--config requires a file argument" >&2
                exit 1
            fi
            CONFIG_FILE="$2"
            echo "Setting config file to $CONFIG_FILE"
            shift 2
            ;;
        -n|--no-service)
            NO_SERVICE=true
            shift
            ;;
        --lan)
            LAN_EXPOSE=true
            shift
            ;;
        -h|--help)
            if [[ ${#POSITIONAL_ARGS[@]} -gt 0 ]]; then
                help_command "${POSITIONAL_ARGS[0]}"
                exit $?
            fi
            usage
            ;;
        --completion)
            completion "${2:-}"
            exit 0
            ;;
        --setup-steps)
            source "$SCRIPT_DIR/setup/lib.sh"
            printf '%s\n' "${SETUP_STEP_ORDER[@]}"
            exit 0
            ;;
        --)
            shift
            POSITIONAL_ARGS+=("$@")
            break
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done

# Restore non-option arguments
set -- "${POSITIONAL_ARGS[@]}"

# Set default config file if not provided
if [[ -z "$CONFIG_FILE" ]]; then
    CONFIG_FILE="$HOME/.config/aibox/aibox.conf"
fi

# Initialize configuration
source "$SCRIPT_DIR/shared-funcs.sh"
source "$SCRIPT_DIR/config-funcs.sh"
init_config_file

# --- CONFIGURATION FROM CONFIG FILE ---
VM_NAME=$(get_config "VM_NAME" "aibox")
GUEST_USER=$(get_config "GUEST_USER" "aibox")
SERVICES_FILE="${HOME}/.config/aibox/services.json"
source "$SCRIPT_DIR/services-funcs.sh"
LIBVIRT_DEFAULT_URI=$(get_config "LIBVIRT_DEFAULT_URI" "qemu:///system")

# VM helpers (the macOS branch replaces this with host/backend.sh).
source "$SCRIPT_DIR/host/vm.sh"

# Handle commands
case "$1" in
    help)
        if [[ -n "${2:-}" ]]; then
            help_command "$2"
            exit $?
        fi
        usage
        ;;
    start)
        "$CMD_DIR/start"
        exit $?
        ;;
    status)
        "$CMD_DIR/status" "${@:2}"
        exit $?
        ;;
    exec)
        "$CMD_DIR/exec" "${@:2}"
        exit $?
        ;;
    web)
        exec "$CMD_DIR/web" "${@:2}"
        ;;
    config)
        "$CMD_DIR/config" "${@:2}"
        exit $?
        ;;
    tunnel)
        "$CMD_DIR/tunnel" "${@:2}"
        exit $?
        ;;
    vscode)
        "$CMD_DIR/vscode" "${@:2}"
        exit $?
        ;;
    service-add)
        "$CMD_DIR/service-add" "${@:2}"
        exit $?
        ;;
    service-remove)
        "$CMD_DIR/service-remove" "${@:2}"
        exit $?
        ;;
    service-list)
        "$CMD_DIR/service-list"
        exit $?
        ;;
    update)
        TARGET="$2"
        if [[ -z "$TARGET" ]]; then
            echo "Usage: aibox update <target> [options]"
            echo "Targets: opencode, opencode-service, dsh, claude, os, scripts, vscode-server, all"
            echo "Options: -y, --yes    Non-interactive system upgrade (os/all)"
            exit 1
        fi
        "$CMD_DIR/update-target" "$TARGET" "$VM_NAME" "$GUEST_USER" "${@:3}"
        exit $?
        ;;
    check-updates)
        "$CMD_DIR/check-updates" "$VM_NAME" "$GUEST_USER" "${@:2}"
        exit $?
        ;;
    self-update)
        "$CMD_DIR/self-update" "$VM_NAME" "$GUEST_USER"
        exit $?
        ;;
    shutdown)
        # Stop the tunnel first so it does not sit waiting for the VM, then
        # shut the VM down. 'aibox start' brings both back.
        "$CMD_DIR/tunnel" stop >/dev/null 2>&1 || true
        "$CMD_DIR/vm-shutdown" "$VM_NAME" "${2:-}"
        exit $?
        ;;
    restart)
        # The tunnel is an SSH connection into the VM: it drops when the VM
        # restarts and reconnects by itself (bounded wait in host/tunnel.sh).
        "$CMD_DIR/vm-restart" "$VM_NAME" "${2:-}"
        RESTART_RC=$?
        if [[ $RESTART_RC -eq 0 ]]; then
            "$CMD_DIR/tunnel" ensure >/dev/null 2>&1 || true
        fi
        exit $RESTART_RC
        ;;
    snapshot)
        "$CMD_DIR/vm-snapshot" "${@:2}"
        exit $?
        ;;
esac

# Validate remaining positional arguments: they must be ports (or host:guest
# pairs). Anything else is most likely a mistyped command.
for arg in "$@"; do
    if [[ "$arg" == *:* ]]; then
        if [[ ! "$arg" =~ ^[0-9]+:[0-9]+$ ]]; then
            print_error "Invalid port mapping '$arg'. Expected <host_port>:<guest_port>."
            echo "Run 'aibox --help' for usage." >&2
            exit 1
        fi
    elif [[ ! "$arg" =~ ^[0-9]+$ ]]; then
        print_error "Unknown command or invalid port: '$arg'"
        echo "Run 'aibox --help' for usage." >&2
        exit 1
    fi
done


# Load services from config (skip if --no-service)
CLI_PORTS=("$@")

# When the tunnel service is installed, configured services are exposed by the
# service; the SSH session only carries ad-hoc ports from the command line.
TUNNEL_INSTALLED=false
if "$CMD_DIR/tunnel" installed >/dev/null 2>&1; then
    TUNNEL_INSTALLED=true
fi

if [[ "$TUNNEL_INSTALLED" == "false" && "$NO_SERVICE" == "false" && -f "$SERVICES_FILE" ]]; then
    print_info "Tunnel service not installed: forwarding services in this session only."
    print_info "Install it once with 'aibox tunnel install' (or 'aibox setup tunnel')."
fi

# Configured services are exposed by the tunnel service when it is installed.
# Otherwise build session forwards here, with the per-service bind address.
SERVICE_FORWARD_ARGS=()

if [[ -f "$SERVICES_FILE" ]]; then
    while IFS=$'\t' read -r name port; do
        [[ -n "$name" && -n "$port" ]] || continue

        if [[ "$port" == *:* ]]; then
            HOST_PORT="${port%%:*}"
            GUEST_PORT="${port#*:}"
        else
            HOST_PORT="$port"
            GUEST_PORT="$port"
        fi

        if [[ "$NO_SERVICE" == "false" && "$TUNNEL_INSTALLED" == "false" ]]; then
            BIND="127.0.0.1"
            [[ "$(service_effective_lan "$name")" != "local" ]] && BIND="0.0.0.0"
            SERVICE_FORWARD_ARGS+=(-L "$BIND:$HOST_PORT:127.0.0.1:$GUEST_PORT")
        fi
    done < <(services_entries)
fi

if [[ "$NO_SERVICE" == "false" && "$TUNNEL_INSTALLED" == "false" ]]; then
    if [[ ${#SERVICE_FORWARD_ARGS[@]} -eq 0 && ${#CLI_PORTS[@]} -eq 0 ]]; then
        echo "No services configured. Add one with: aibox service-add <name> <port>"
        exit 1
    fi
fi

if [[ "$NO_SERVICE" == "true" && ${#CLI_PORTS[@]} -eq 0 ]]; then
    echo "Connecting without services (--no-service)"
fi

set -- "${CLI_PORTS[@]}"

# Start VM if it's not running
if ! vm_exists "$VM_NAME"; then
    print_error "VM '$VM_NAME' does not exist."
    echo "Run 'aibox setup' to create it." >&2
    exit 1
fi

VM_STATE=$(vm_state "$VM_NAME")
if [[ "$VM_STATE" != "running" ]]; then
    echo "Starting $VM_NAME..."
    vm_start "$VM_NAME"
fi

# Make sure the tunnel service is up for the configured services.
if [[ "$NO_SERVICE" == "false" && "$TUNNEL_INSTALLED" == "true" ]]; then
    "$CMD_DIR/tunnel" ensure >/dev/null 2>&1 || true
fi

# Dynamic IP Detection
echo -n "Detecting Guest IP..."
for i in {1..20}; do
    GUEST_IP=$(vm_ip "$VM_NAME")
    if [ -n "$GUEST_IP" ]; then
        break
    fi
    printf "."
    sleep 1
done

if [ -z "$GUEST_IP" ]; then
    echo -e "\nError: Could not detect Guest IP."
    exit 1
fi
echo -e "\nFound IP: $GUEST_IP"

# Ad-hoc forwards bind to localhost unless --lan is given.
BIND_ADDR="127.0.0.1"
if [[ "$LAN_EXPOSE" == "true" ]]; then
    BIND_ADDR="0.0.0.0"
fi

# Build the SSH forwarding arguments: configured services (when the tunnel
# service is not installed) plus ad-hoc ports from the command line.
FORWARD_ARGS=("${SERVICE_FORWARD_ARGS[@]}")
if [[ $# -gt 0 ]]; then
    for ARG in "$@"; do
        if [[ "$ARG" == *:* ]]; then
            HOST_PORT="${ARG%%:*}"
            GUEST_PORT="${ARG#*:}"
        else
            HOST_PORT="$ARG"
            GUEST_PORT="$ARG"
        fi

        FORWARD_ARGS+=(-L "$BIND_ADDR:$HOST_PORT:127.0.0.1:$GUEST_PORT")
    done
fi

# Wait for SSH to be ready
echo -n "Waiting for SSH..."
while ! nc -z -w 1 "$GUEST_IP" 22 &>/dev/null; do
    printf "."
    sleep 1
done
echo -e "\nSSH is ready!"

# Connect
if [[ ${#FORWARD_ARGS[@]} -gt 0 ]]; then
    if [[ $# -gt 0 ]]; then
        echo "Connecting to $GUEST_USER@$GUEST_IP with port(s): $*"
    else
        echo "Connecting to $GUEST_USER@$GUEST_IP with configured services"
    fi
else
    echo "Connecting to $GUEST_USER@$GUEST_IP (no port forwarding)"
fi

ssh -o ConnectTimeout=5 "${FORWARD_ARGS[@]}" "$GUEST_USER@$GUEST_IP"
