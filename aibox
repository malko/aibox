#!/bin/bash

# Resolve symlinks to get actual script location
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SCRIPT_SOURCE="$(readlink -f "$SCRIPT_SOURCE")"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
CMD_DIR="$SCRIPT_DIR/cmd"

# Global options
CONFIG_FILE=""
OPEN_WEB=false
NO_SERVICE=false
LAN_EXPOSE=false
PEON_RELAY=false
POSITIONAL_ARGS=()

usage() {
    echo "Usage: aibox [options] [service] [host_port:guest_port] [port] ..."
    echo ""
    echo "Commands:"
    echo "  start                             Start the VM and the tunnel service"
    echo "  status                            VM state, service URLs and tunnel state"
    echo "  tunnel <command>                  Manage the tunnel service (see 'aibox tunnel help')"
    echo "  service-add <name> <port[:port]>  Add a service"
    echo "  service-remove <name>             Remove a service"
    echo "  service-list                      List configured services"
    echo "  relay                             Enable/disable peon-ping relay by default"
    echo "  setup [step ...]                  Run setup steps (see 'aibox setup --help')"
    echo "  update <target>                   Update (opencode, opencode-password, dsh, os, scripts, vscode-server, all)"
    echo "  check-updates                     Check for available updates (host + VM)"
    echo "  self-update                       Pull the aibox repo and push scripts to the VM"
    echo "  shutdown [-f]                     Stop tunnel + shutdown VM (use -f to force)"
    echo "  restart [-f]                      Restart VM (tunnel reconnects automatically)"
    echo "  snapshot create [name]            Create snapshot"
    echo "  snapshot list                     List snapshots"
    echo "  snapshot delete <name>            Delete snapshot"
    echo "  snapshot revert <name>            Revert to snapshot"
    echo ""
    echo "Examples:"
    echo "  aibox                                Connect and open a shell"
    echo "  aibox start                          Start VM + tunnel without connecting"
    echo "  aibox status                         Show VM, URLs and tunnel state"
    echo "  aibox tunnel lan on                  Expose services on the LAN"
    echo "  aibox -c /path/to/config.conf        Use custom config file"
    echo "  aibox service-add opencode 4096      Add opencode service"
    echo "  aibox setup motd                     Reconfigure the MOTD only"
    echo "  aibox update opencode                Update and restart opencode"
    echo "  aibox update opencode-password       Set opencode password"
    echo "  aibox update scripts                 Upload scripts to VM"
    echo "  aibox shutdown                       Gracefully shutdown VM"
    echo "  aibox restart                        Restart VM"
    echo "  aibox snapshot create                Create snapshot with auto name"
    echo ""
    echo "Options:"
    echo "  -c, --config FILE    Path to config file (default: ~/.config/aibox/aibox.conf)"
    echo "  -w, --open-web       Open browser after connecting"
    echo "  -n, --no-service     Start without SSH tunnels (no port forwarding)"
    echo "      --lan            Bind ad-hoc forwarded ports on the LAN (0.0.0.0)"
    echo "  -p, --peon-relay     Enable peon-ping relay (port 19998)"
    echo "  -h, --help           Show this help"
    echo "  --completion [shell] Output shell completion script (bash or zsh)"
    exit 0
}

load_services() {
    if [[ -f "$SERVICES_FILE" ]]; then
        jq -r 'to_entries[] | .value' "$SERVICES_FILE" 2>/dev/null || echo ""
    fi
}

completion() {
    # Detect shell if not specified
    local shell="${1:-}"
    [[ -z "$shell" ]] && shell="bash"

    if [[ "$shell" == "zsh" ]]; then
        cat << 'ZEOF'
#compdef aibox

local -a commands
commands=(
  'start:start VM and tunnel'
  'status:show VM, URLs and tunnel state'
  'tunnel:manage the tunnel service'
  'service-add:add a service'
  'service-remove:remove a service'
  'service-list:list configured services'
  'setup:run setup steps'
  'update:update service or app (opencode, opencode-password, dsh, os, scripts, vscode-server, all)'
  'check-updates:check for available updates (host + VM)'
  'self-update:pull the aibox repo and push scripts to the VM'
  'shutdown:shutdown VM'
  'restart:restart VM'
  'snapshot:manage snapshots'
)

_arguments -C '1: :->command' '*: :->args'

case $state in
  command)
    _describe 'command' commands
    ;;
  args)
    case $words[1] in
      service-add)
        _message 'service name'
        ;;
      tunnel)
        _values 'tunnel command' start stop restart status logs install uninstall 'lan on' 'lan off'
        ;;
      service-remove)
        _values 'services' $(jq -r 'keys[]' ~/.config/aibox/services.json 2>/dev/null)
        ;;
      snapshot)
        local -a snapshot_cmds
        snapshot_cmds=(
          'create:create snapshot'
          'list:list snapshots'
          'delete:delete snapshot'
          'revert:revert to snapshot'
        )
        _describe 'snapshot command' snapshot_cmds
        ;;
      shutdown|restart)
        _values 'flags' '-f --force'
        ;;
      setup)
        _values 'steps' $(aibox --setup-steps) all
        ;;
      update)
        _values 'targets' 'opencode' 'opencode-password' 'dsh' 'os' 'scripts' 'vscode-server' 'all'
        ;;
    esac
    ;;
esac
ZEOF
    else
        # Bash completion
        cat << 'BASHEOF'
_aibox() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    opts="start status tunnel service-add service-remove service-list setup update check-updates self-update shutdown restart snapshot"

    case "${prev}" in
        aibox)
            COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
            return 0
            ;;
        service-add)
            return 0
            ;;
        tunnel)
            COMPREPLY=($(compgen -W "start stop restart status logs install uninstall lan" -- "${cur}"))
            return 0
            ;;
        setup)
            COMPREPLY=($(compgen -W "$(aibox --setup-steps) all" -- "${cur}"))
            return 0
            ;;
        service-remove)
            COMPREPLY=($(compgen -W "$(jq -r 'keys[]' ~/.config/aibox/services.json 2>/dev/null)" -- "${cur}"))
            return 0
            ;;
        snapshot)
            COMPREPLY=($(compgen -W "create list delete revert" -- "${cur}"))
            return 0
            ;;
        update)
            COMPREPLY=($(compgen -W "opencode opencode-password dsh os scripts vscode-server all" -- "${cur}"))
            return 0
            ;;
        shutdown|restart)
            COMPREPLY=($(compgen -W "-f --force" -- "${cur}"))
            return 0
            ;;
        -f|--force)
            return 0
            ;;
        create|delete|revert)
            COMPREPLY=($(compgen -W "$(virsh snapshot-list aibox --name 2>/dev/null)" -- "${cur}"))
            return 0
            ;;
    esac

    COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
    return 0
}

complete -F _aibox aibox
BASHEOF
    fi
}

# 'setup' relays its arguments verbatim to setup.sh (it has its own options).
if [[ "${1:-}" == "setup" ]]; then
    shift
    exec "$SCRIPT_DIR/setup.sh" "$@"
fi

# --- Argument Parsing ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--config)
            if [[ $# -lt 2 || "$2" == -* ]]; then
                echo "Error: -c/--config requires a file argument" >&2
                exit 1
            fi
            CONFIG_FILE="$2"
            echo "Setting config file to $CONFIG_FILE"
            shift 2
            ;;
        -w|--open-web)
            OPEN_WEB=true
            shift
            ;;
        -n|--no-service)
            NO_SERVICE=true
            shift
            ;;
        --lan)
            LAN_EXPOSE=true
            shift
            ;;
        -p|--peon-relay)
            PEON_RELAY=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        --completion)
            completion "${2:-}"
            exit 0
            ;;
        --setup-steps)
            source "$SCRIPT_DIR/setup/lib.sh"
            printf '%s\n' "${SETUP_STEP_ORDER[@]}"
            exit 0
            ;;
        --)
            shift
            POSITIONAL_ARGS+=("$@")
            break
            ;;
        *)
            POSITIONAL_ARGS+=("$1")
            shift
            ;;
    esac
done

# Restore non-option arguments
set -- "${POSITIONAL_ARGS[@]}"

# Set default config file if not provided
if [[ -z "$CONFIG_FILE" ]]; then
    CONFIG_FILE="$HOME/.config/aibox/aibox.conf"
fi

# Initialize configuration
source "$SCRIPT_DIR/shared-funcs.sh"
source "$SCRIPT_DIR/config-funcs.sh"
init_config_file

# --- CONFIGURATION FROM CONFIG FILE ---
VM_NAME=$(get_config "VM_NAME" "aibox")
GUEST_USER=$(get_config "GUEST_USER" "aibox")
SERVICES_FILE="${HOME}/.config/aibox/services.json"
LIBVIRT_DEFAULT_URI=$(get_config "LIBVIRT_DEFAULT_URI" "qemu:///system")
[[ "$PEON_RELAY" == "false" ]] && PEON_RELAY=$(get_config "PEON_RELAY" "false")

# VM helpers (the macOS branch replaces this with host/backend.sh).
source "$SCRIPT_DIR/host/vm.sh"

# Handle commands
case "$1" in
    help)
        usage
        exit 0
        ;;
    start)
        "$CMD_DIR/start"
        exit $?
        ;;
    status)
        "$CMD_DIR/status"
        exit $?
        ;;
    tunnel)
        "$CMD_DIR/tunnel" "${@:2}"
        exit $?
        ;;
    service-add)
        "$CMD_DIR/service-add" "${@:2}"
        exit $?
        ;;
    service-remove)
        "$CMD_DIR/service-remove" "${@:2}"
        exit $?
        ;;
    service-list)
        "$CMD_DIR/service-list"
        exit $?
        ;;
    relay)
        source "$SCRIPT_DIR/config-funcs.sh"
        init_config_file
        case "$2" in
            on|enable|true|yes)
                save_config "PEON_RELAY" "true"
                echo "Peon relay enabled in config."
                ;;
            off|disable|false|no)
                save_config "PEON_RELAY" "false"
                echo "Peon relay disabled in config."
                ;;
            *)
                echo "Usage: aibox relay [on|off]"
                exit 1
                ;;
        esac
        exit 0
        ;;
    update)
        TARGET="$2"
        if [[ -z "$TARGET" ]]; then
            echo "Usage: aibox update <target> [options]"
            echo "Targets: opencode, opencode-password, dsh, os, scripts, vscode-server, all"
            echo "Options: -y, --yes    Non-interactive system upgrade (os/all)"
            exit 1
        fi
        "$CMD_DIR/update-target" "$TARGET" "$VM_NAME" "$GUEST_USER" "${@:3}"
        exit $?
        ;;
    check-updates)
        "$CMD_DIR/check-updates" "$VM_NAME" "$GUEST_USER"
        exit $?
        ;;
    self-update)
        "$CMD_DIR/self-update" "$VM_NAME" "$GUEST_USER"
        exit $?
        ;;
    shutdown)
        # Stop the tunnel first so it does not sit waiting for the VM, then
        # shut the VM down. 'aibox start' brings both back.
        "$CMD_DIR/tunnel" stop >/dev/null 2>&1 || true
        "$CMD_DIR/vm-shutdown" "$VM_NAME" "${2:-}"
        exit $?
        ;;
    restart)
        # The tunnel is an SSH connection into the VM: it drops when the VM
        # restarts and reconnects by itself (bounded wait in host/tunnel.sh).
        "$CMD_DIR/vm-restart" "$VM_NAME" "${2:-}"
        RESTART_RC=$?
        if [[ $RESTART_RC -eq 0 ]]; then
            "$CMD_DIR/tunnel" ensure >/dev/null 2>&1 || true
        fi
        exit $RESTART_RC
        ;;
    snapshot)
        "$CMD_DIR/vm-snapshot" "${@:2}"
        exit $?
        ;;
esac

# Validate remaining positional arguments: they must be ports (or host:guest
# pairs). Anything else is most likely a mistyped command.
for arg in "$@"; do
    if [[ "$arg" == *:* ]]; then
        if [[ ! "$arg" =~ ^[0-9]+:[0-9]+$ ]]; then
            print_error "Invalid port mapping '$arg'. Expected <host_port>:<guest_port>."
            echo "Run 'aibox --help' for usage." >&2
            exit 1
        fi
    elif [[ ! "$arg" =~ ^[0-9]+$ ]]; then
        print_error "Unknown command or invalid port: '$arg'"
        echo "Run 'aibox --help' for usage." >&2
        exit 1
    fi
done


# Load services from config (skip if --no-service)
CLI_PORTS=("$@")

# When the tunnel service is installed, configured services are exposed by the
# service; the SSH session only carries ad-hoc ports from the command line.
TUNNEL_INSTALLED=false
if "$CMD_DIR/tunnel" installed >/dev/null 2>&1; then
    TUNNEL_INSTALLED=true
fi

if [[ "$TUNNEL_INSTALLED" == "false" && "$NO_SERVICE" == "false" && -f "$SERVICES_FILE" ]]; then
    print_info "Tunnel service not installed: forwarding services in this session only."
    print_info "Install it once with 'aibox tunnel install' (or 'aibox setup tunnel')."
fi

if [[ "$NO_SERVICE" == "false" ]]; then
    if [[ "$TUNNEL_INSTALLED" == "true" ]]; then
        set -- "${CLI_PORTS[@]}"
    else
        SERVICES=()
        while IFS= read -r port; do
            [[ -n "$port" ]] && SERVICES+=("$port")
        done < <(load_services)

        # Merge command line args with services
        ALL_PORTS=("${SERVICES[@]}")
        for arg in "${CLI_PORTS[@]}"; do
            ALL_PORTS+=("$arg")
        done

        # Use all ports or default to services
        if [[ ${#ALL_PORTS[@]} -eq 0 && ${#SERVICES[@]} -gt 0 ]]; then
            set -- "${SERVICES[@]}"
        elif [[ ${#ALL_PORTS[@]} -eq 0 ]]; then
            echo "No services configured. Add one with: aibox service-add <name> <port>"
            exit 1
        else
            set -- "${ALL_PORTS[@]}"
        fi
    fi
else
    # --no-service: only use command line port args
    set -- "${CLI_PORTS[@]}"
    if [[ $# -eq 0 ]]; then
        echo "Connecting without services (--no-service)"
    fi
fi

# Start VM if it's not running
if ! vm_exists "$VM_NAME"; then
    print_error "VM '$VM_NAME' does not exist."
    echo "Run 'aibox setup' to create it." >&2
    exit 1
fi

VM_STATE=$(vm_state "$VM_NAME")
if [[ "$VM_STATE" != "running" ]]; then
    echo "Starting $VM_NAME..."
    vm_start "$VM_NAME"
fi

# Make sure the tunnel service is up for the configured services.
if [[ "$NO_SERVICE" == "false" && "$TUNNEL_INSTALLED" == "true" ]]; then
    "$CMD_DIR/tunnel" ensure >/dev/null 2>&1 || true
fi

# Dynamic IP Detection
echo -n "Detecting Guest IP..."
for i in {1..20}; do
    GUEST_IP=$(vm_ip "$VM_NAME")
    if [ -n "$GUEST_IP" ]; then
        break
    fi
    printf "."
    sleep 1
done

if [ -z "$GUEST_IP" ]; then
    echo -e "\nError: Could not detect Guest IP."
    exit 1
fi
echo -e "\nFound IP: $GUEST_IP"

# Ad-hoc forwards bind to localhost unless --lan is given.
BIND_ADDR="127.0.0.1"
if [[ "$LAN_EXPOSE" == "true" ]]; then
    BIND_ADDR="0.0.0.0"
fi

# Build the Forwarding String (only if ports are specified)
FORWARD_ARGS=""
if [[ $# -gt 0 ]]; then
    for ARG in "$@"; do
        if [[ "$ARG" == *:* ]]; then
            HOST_PORT="${ARG%%:*}"
            GUEST_PORT="${ARG#*:}"
        else
            HOST_PORT="$ARG"
            GUEST_PORT="$ARG"
        fi

        FORWARD_ARGS="$FORWARD_ARGS -L $BIND_ADDR:$HOST_PORT:127.0.0.1:$GUEST_PORT"
    done
fi

if [[ "$PEON_RELAY" == "true" ]]; then
    FORWARD_ARGS="$FORWARD_ARGS -R 19998:localhost:19998"
fi

# Wait for SSH to be ready
echo -n "Waiting for SSH..."
while ! nc -z -w 1 "$GUEST_IP" 22 &>/dev/null; do
    printf "."
    sleep 1
done
echo -e "\nSSH is ready!"

# Connect
if [[ -n "$FORWARD_ARGS" ]]; then
    echo "Connecting to $GUEST_USER@$GUEST_IP with port(s): $*"
else
    echo "Connecting to $GUEST_USER@$GUEST_IP (no port forwarding)"
fi

# Open browser if -w flag is set
if [[ "$OPEN_WEB" == "true" ]]; then
    if [[ $# -gt 0 ]]; then
        HOST_PORT="${1%%:*}"
    else
        HOST_PORT=$(jq -r 'to_entries[0].value' "$SERVICES_FILE" 2>/dev/null || echo "")
        HOST_PORT="${HOST_PORT%%:*}"
    fi

    if [[ -z "$HOST_PORT" ]]; then
        print_error "No service port to open."
    else
        if [[ "$LAN_EXPOSE" == "true" ]]; then
            URL_HOST=$(hostname).local
        else
            URL_HOST="localhost"
        fi
        BROWSER_URL="http://${URL_HOST}:${HOST_PORT}"

        echo "Opening browser to $BROWSER_URL..."
        if command -v xdg-open &>/dev/null; then
            xdg-open "$BROWSER_URL" &
        elif command -v open &>/dev/null; then
            open "$BROWSER_URL" &
        fi
    fi
fi

ssh -o ConnectTimeout=5 $FORWARD_ARGS "$GUEST_USER@$GUEST_IP"
