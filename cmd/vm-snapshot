#!/bin/bash
set -e

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SCRIPT_SOURCE="$(readlink -f "$SCRIPT_SOURCE")"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")/.." && pwd)"
CONFIG_FILE="$HOME/.config/aibox/aibox.conf"
source "$SCRIPT_DIR/config-funcs.sh"
source "$SCRIPT_DIR/shared-funcs.sh"
init_config_file

VM_NAME=$(get_config "VM_NAME" "aibox")
LIBVIRT_DEFAULT_URI=$(get_config "LIBVIRT_DEFAULT_URI" "qemu:///system")
ACTION="${1:-}"
SNAPSHOT_NAME=""
ASSUME_YES=false
JSON=false
RESTART=false

vm_state() {
    LC_ALL=C virsh -c "$LIBVIRT_DEFAULT_URI" domstate "$VM_NAME" 2>/dev/null || echo "unknown"
}

usage_snapshot() {
    echo "Usage: aibox snapshot <command> [options]"
    echo ""
    echo "Commands:"
    echo "  create [name]     Create snapshot (auto-generates name if not provided)"
    echo "  list              List all snapshots"
    echo "  delete <name>     Delete a snapshot"
    echo "  revert <name>     Revert to a snapshot"
    echo ""
    echo "Options:"
    echo "  -y, --yes         Do not ask for confirmation (shuts the VM down first)"
    echo "  --json            Print machine-readable JSON (list only)"
    echo "  --start           Start the VM again after a create or a revert"
    echo "  -h, --help        Show this help"
    echo ""
    echo "Examples:"
    echo "  aibox snapshot create"
    echo "  aibox snapshot create my-snapshot"
    echo "  aibox snapshot list"
    echo "  aibox snapshot list --json"
    echo "  aibox snapshot delete my-snapshot"
    echo "  aibox snapshot revert my-snapshot --yes --start"
}

# snapshot_names: one snapshot name per line.
snapshot_names() {
    LC_ALL=C virsh -c "$LIBVIRT_DEFAULT_URI" snapshot-list "$VM_NAME" --name 2>/dev/null || true
}

# snapshot_field <name> <field>: reads a field of a snapshot XML dump.
snapshot_field() {
    LC_ALL=C virsh -c "$LIBVIRT_DEFAULT_URI" snapshot-dumpxml "$VM_NAME" "$1" 2>/dev/null \
        | sed -nE "s#.*<$2>([^<]*)</$2>.*#\1#p" | head -n 1
}

# snapshots_json: machine-readable list of the snapshots.
snapshots_json() {
    local name state created

    printf '['
    local first=true
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        state=$(snapshot_field "$name" state)
        created=$(snapshot_field "$name" creationTime)
        [[ "$first" == "true" ]] || printf ','
        first=false
        jq -n \
            --arg name "$name" \
            --arg state "$state" \
            --argjson created "${created:-0}" \
            '{
                name: $name,
                state: (if $state == "" then null else $state end),
                created: (if $created == 0 then null else $created end)
            }'
    done < <(snapshot_names)
    printf ']\n'
}

# wait_shutdown: waits for the VM to be shut off, up to 30 seconds.
wait_shutdown() {
    local i state
    for ((i = 0; i < 30; i++)); do
        state=$(vm_state)
        [[ "$state" == "shut off" ]] && return 0
        sleep 1
    done
    return 1
}

# The snapshot name is the first non-flag argument after the action.
for arg in "${@:2}"; do
    case "$arg" in
        -y|--yes) ASSUME_YES=true ;;
        --json) JSON=true ;;
        --start) RESTART=true ;;
        -h|--help) usage_snapshot; exit 0 ;;
        -*) ;;
        *) [[ -z "$SNAPSHOT_NAME" ]] && SNAPSHOT_NAME="$arg" ;;
    esac
done

case "$ACTION" in
    -h|--help)
        usage_snapshot
        exit 0
        ;;

    list)
        if [[ "$JSON" == "true" ]]; then
            snapshots_json
            exit 0
        fi
        echo "Snapshots for VM '$VM_NAME':"
        snapshot_names | grep -q . || echo "No snapshots found."
        snapshot_names | sed '/^$/d'
        ;;

    create)
        if [[ -z "$SNAPSHOT_NAME" ]]; then
            SNAPSHOT_NAME="aibox-$(date +%Y%m%d-%H%M%S)"
        fi

        STATE=$(vm_state)
        if [[ "$STATE" == "running" ]]; then
            if [[ "$ASSUME_YES" != "true" ]]; then
                echo "Warning: VM is running. For reliable internal snapshots, shutdown first."
                read -p "Shutdown VM and create snapshot? [y/N]: " -n 1 -r
                echo
                if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                    echo "Cancelled. Run './aibox shutdown' first."
                    exit 0
                fi
            fi

            echo "Shutting down the VM..."
            LC_ALL=C virsh -c "$LIBVIRT_DEFAULT_URI" shutdown "$VM_NAME" 2>/dev/null || true
            if ! wait_shutdown; then
                echo "Error: the VM did not shut down in time."
                exit 1
            fi
        fi

        echo "Creating internal snapshot '$SNAPSHOT_NAME'..."
        ERROR_OUTPUT=$(LC_ALL=C virsh -c "$LIBVIRT_DEFAULT_URI" snapshot-create-as "$VM_NAME" "$SNAPSHOT_NAME" 2>&1) || {
            echo "Failed to create snapshot: $ERROR_OUTPUT"
            exit 1
        }

        echo "Snapshot '$SNAPSHOT_NAME' created successfully."

        if [[ "$RESTART" == "true" ]]; then
            echo "Starting the VM again..."
            LC_ALL=C virsh -c "$LIBVIRT_DEFAULT_URI" start "$VM_NAME" 2>/dev/null || true
        fi
        ;;

    delete)
        if [[ -z "$SNAPSHOT_NAME" ]]; then
            echo "Usage: $0 delete <snapshot-name>"
            exit 1
        fi

        echo "Deleting snapshot '$SNAPSHOT_NAME'..."
        LC_ALL=C virsh -c "$LIBVIRT_DEFAULT_URI" snapshot-delete "$VM_NAME" "$SNAPSHOT_NAME" --metadata 2>/dev/null || \
            LC_ALL=C virsh -c "$LIBVIRT_DEFAULT_URI" snapshot-delete "$VM_NAME" "$SNAPSHOT_NAME"

        echo "Snapshot '$SNAPSHOT_NAME' deleted."
        ;;

    revert)
        if [[ -z "$SNAPSHOT_NAME" ]]; then
            echo "Usage: $0 revert <snapshot-name>"
            exit 1
        fi

        STATE=$(vm_state)
        if [[ "$STATE" == "running" ]]; then
            echo "VM is running. Shutting down before reverting..."
            LC_ALL=C virsh -c "$LIBVIRT_DEFAULT_URI" shutdown "$VM_NAME" 2>/dev/null || true
            if ! wait_shutdown; then
                echo "Error: the VM did not shut down in time."
                exit 1
            fi
        fi

        STATE=$(vm_state)
        if [[ "$STATE" != "shut off" ]]; then
            echo "Error: VM did not shutdown in time."
            exit 1
        fi

        echo "Reverting to snapshot '$SNAPSHOT_NAME'..."
        LC_ALL=C virsh -c "$LIBVIRT_DEFAULT_URI" snapshot-revert "$VM_NAME" "$SNAPSHOT_NAME"

        if [[ "$RESTART" == "true" ]]; then
            echo "Starting the VM again..."
            LC_ALL=C virsh -c "$LIBVIRT_DEFAULT_URI" start "$VM_NAME" 2>/dev/null || true
        fi

        echo ""
        echo "VM reverted to '$SNAPSHOT_NAME'."
        [[ "$RESTART" == "true" ]] || echo "Run './aibox' to restart the VM."
        ;;

    *)
        usage_snapshot >&2
        exit 1
        ;;
esac
