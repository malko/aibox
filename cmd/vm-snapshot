#!/bin/bash
set -e

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SCRIPT_SOURCE="$(readlink -f "$SCRIPT_SOURCE")"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")/.." && pwd)"
CONFIG_FILE="$HOME/.config/aibox/aibox.conf"
source "$SCRIPT_DIR/config-funcs.sh"
init_config_file

VM_NAME=$(get_config "VM_NAME" "aibox")
LIBVIRT_DEFAULT_URI=$(get_config "LIBVIRT_DEFAULT_URI" "qemu:///system")
ACTION="${1:-}"
SNAPSHOT_NAME="${2:-}"

vm_state() {
    virsh -c "$LIBVIRT_DEFAULT_URI" domstate "$VM_NAME" 2>/dev/null || echo "unknown"
}

case "$ACTION" in
    list)
        echo "Snapshots for VM '$VM_NAME':"
        virsh -c "$LIBVIRT_DEFAULT_URI" snapshot-list "$VM_NAME" --name 2>/dev/null || echo "No snapshots found."
        ;;

    create)
        if [[ -z "$SNAPSHOT_NAME" ]]; then
            SNAPSHOT_NAME="aibox-$(date +%Y%m%d-%H%M%S)"
        fi

        STATE=$(vm_state)
        if [[ "$STATE" == "running" ]]; then
            echo "Warning: VM is running. For reliable internal snapshots, shutdown first."
            read -p "Shutdown VM and create snapshot? [y/N]: " -n 1 -r
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                echo "Cancelled. Run './aibox shutdown' first."
                exit 0
            fi
            virsh -c "$LIBVIRT_DEFAULT_URI" shutdown "$VM_NAME"
            for i in {1..30}; do
                STATE=$(vm_state)
                [[ "$STATE" == "shut off" ]] && break
                sleep 1
            done
        fi

        echo "Creating internal snapshot '$SNAPSHOT_NAME'..."
        ERROR_OUTPUT=$(virsh -c "$LIBVIRT_DEFAULT_URI" snapshot-create-as "$VM_NAME" "$SNAPSHOT_NAME" 2>&1) || {
            echo "Failed to create snapshot: $ERROR_OUTPUT"
            exit 1
        }

        echo "Snapshot '$SNAPSHOT_NAME' created successfully."
        ;;

    delete)
        if [[ -z "$SNAPSHOT_NAME" ]]; then
            echo "Usage: $0 delete <snapshot-name>"
            exit 1
        fi

        echo "Deleting snapshot '$SNAPSHOT_NAME'..."
        virsh -c "$LIBVIRT_DEFAULT_URI" snapshot-delete "$VM_NAME" "$SNAPSHOT_NAME" --metadata 2>/dev/null || \
            virsh -c "$LIBVIRT_DEFAULT_URI" snapshot-delete "$VM_NAME" "$SNAPSHOT_NAME"

        echo "Snapshot '$SNAPSHOT_NAME' deleted."
        ;;

    revert)
        if [[ -z "$SNAPSHOT_NAME" ]]; then
            echo "Usage: $0 revert <snapshot-name>"
            exit 1
        fi

        STATE=$(vm_state)
        if [[ "$STATE" == "running" ]]; then
            echo "VM is running. Shutting down before reverting..."
            virsh -c "$LIBVIRT_DEFAULT_URI" shutdown "$VM_NAME"
            for i in {1..30}; do
                STATE=$(vm_state)
                [[ "$STATE" == "shut off" ]] && break
                sleep 1
            done
        fi

        STATE=$(vm_state)
        if [[ "$STATE" != "shut off" ]]; then
            echo "Error: VM did not shutdown in time."
            exit 1
        fi

        echo "Reverting to snapshot '$SNAPSHOT_NAME'..."
        virsh -c "$LIBVIRT_DEFAULT_URI" snapshot-revert "$VM_NAME" "$SNAPSHOT_NAME"

        echo ""
        echo "VM reverted to '$SNAPSHOT_NAME'."
        echo "Run './aibox start' to restart the VM."
        ;;

    *)
        echo "Usage: $0 <command> [options]"
        echo ""
        echo "Commands:"
        echo "  create [name]     Create snapshot (auto-generates name if not provided)"
        echo "  list              List all snapshots"
        echo "  delete <name>    Delete a snapshot"
        echo "  revert <name>    Revert to a snapshot"
        echo ""
        echo "Examples:"
        echo "  $0 create                  # Create snapshot with auto-generated name"
        echo "  $0 create my-snapshot     # Create snapshot with custom name"
        echo "  $0 list                   # List all snapshots"
        echo "  $0 delete my-snapshot     # Delete a snapshot"
        echo "  $0 revert my-snapshot     # Revert to a snapshot"
        exit 1
        ;;
esac
