#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$SCRIPT_DIR/services-funcs.sh"

usage() {
    echo "Usage: aibox service-remove <name>"
    echo ""
    echo "Remove a service from services.json and stop forwarding its port."
    echo "Any LAN exposure (permanent or temporary) for that service is removed too."
    echo ""
    echo "Options:"
    echo "  -h, --help      Show this help"
    echo ""
    echo "Examples:"
    echo "  aibox service-remove portainer"
}

SERVICE_NAME=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Error: unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            if [[ -n "$SERVICE_NAME" ]]; then
                echo "Error: too many arguments: $1" >&2
                usage >&2
                exit 1
            fi
            SERVICE_NAME="$1"
            shift
            ;;
    esac
done

if [[ -z "$SERVICE_NAME" ]]; then
    usage >&2
    exit 1
fi

if [[ ! "$SERVICE_NAME" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: invalid service name '$SERVICE_NAME'." >&2
    exit 1
fi

if ! services_require_jq; then
    exit 1
fi

if ! service_exists "$SERVICE_NAME"; then
    echo "Service '$SERVICE_NAME' not found."
    exit 1
fi

if ! service_remove_json "$SERVICE_NAME"; then
    echo "Error: could not update $SERVICES_FILE." >&2
    exit 1
fi
lan_runtime_remove "$SERVICE_NAME" || true

echo "Removed service '$SERVICE_NAME'"

# Drop the port from a running tunnel.
if [[ -x "$SCRIPT_DIR/cmd/tunnel" ]]; then
    "$SCRIPT_DIR/cmd/tunnel" reload >/dev/null 2>&1 || true
fi
