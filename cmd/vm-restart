#!/bin/bash
set -e

usage_restart() {
    echo "Usage: aibox restart [-f|--force]"
    echo ""
    echo "Shut the VM down, start it again, and let the tunnel reconnect."
    echo "With -f, force the shutdown step."
    echo ""
    echo "Options:"
    echo "  -f, --force     Force the shutdown step"
    echo "  -h, --help      Show this help"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage_restart
    exit 0
fi

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SCRIPT_SOURCE="$(readlink -f "$SCRIPT_SOURCE")"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")/.." && pwd)"

VM_NAME="${1:-aibox}"
FORCE="${2:-}"

# Reuse the existing shutdown/start logic so restart stays a thin wrapper.
"$SCRIPT_DIR/cmd/vm-shutdown" "$VM_NAME" "$FORCE"
"$SCRIPT_DIR/host/start-vm.sh" "$VM_NAME"
