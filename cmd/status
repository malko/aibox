#!/bin/bash
set -e

usage_status() {
    echo "Usage: aibox status"
    echo ""
    echo "Show the VM state, tunnel service state and per-service URLs, including"
    echo "whether each service is localhost-only, permanently on the LAN, or"
    echo "temporarily exposed."
    echo ""
    echo "Options:"
    echo "  --json          Print machine-readable JSON"
    echo "  -h, --help      Show this help"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage_status
    exit 0
fi

if [[ "${1:-}" == "--json" ]]; then
    SCRIPT_SOURCE="${BASH_SOURCE[0]}"
    while [[ -L "$SCRIPT_SOURCE" ]]; do
        SOURCE_LINK="$(readlink "$SCRIPT_SOURCE")"
        if [[ "$SOURCE_LINK" == /* ]]; then
            SCRIPT_SOURCE="$SOURCE_LINK"
        else
            SCRIPT_SOURCE="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)/$SOURCE_LINK"
        fi
    done
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")/.." && pwd)"
    exec "$SCRIPT_DIR/cmd/tunnel" status --json "${@:2}"
fi

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SOURCE_LINK="$(readlink "$SCRIPT_SOURCE")"
    if [[ "$SOURCE_LINK" == /* ]]; then
        SCRIPT_SOURCE="$SOURCE_LINK"
    else
        SCRIPT_SOURCE="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)/$SOURCE_LINK"
    fi
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")/.." && pwd)"
CONFIG_FILE="$HOME/.config/aibox/aibox.conf"
source "$SCRIPT_DIR/shared-funcs.sh"
source "$SCRIPT_DIR/config-funcs.sh"
init_config_file
source "$SCRIPT_DIR/host/backend.sh"

VM_NAME=$(get_config "VM_NAME" "aibox")

echo "=== AIBox status ==="

if vm_exists "$VM_NAME"; then
    STATE=$(vm_state "$VM_NAME")
    echo "VM:       $VM_NAME ($STATE)"
    if [[ "$STATE" == "running" ]]; then
        GUEST_IP=$(vm_ip "$VM_NAME")
        [[ -n "$GUEST_IP" ]] && echo "IP:       $GUEST_IP"
    fi
else
    echo "VM:       $VM_NAME (not created - run 'aibox setup')"
fi

echo ""
exec "$SCRIPT_DIR/cmd/tunnel" status
