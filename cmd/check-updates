#!/bin/bash
set -e

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SOURCE_LINK="$(readlink "$SCRIPT_SOURCE")"
    if [[ "$SOURCE_LINK" == /* ]]; then
        SCRIPT_SOURCE="$SOURCE_LINK"
    else
        SCRIPT_SOURCE="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)/$SOURCE_LINK"
    fi
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")/.." && pwd)"
CONFIG_FILE="$HOME/.config/aibox/aibox.conf"
source "$SCRIPT_DIR/shared-funcs.sh"
source "$SCRIPT_DIR/config-funcs.sh"
init_config_file
source "$SCRIPT_DIR/host/backend.sh"

if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
fi

VM_NAME=${1:-$(get_config "VM_NAME" "aibox")}

# aibox itself lives on the host: check for new commits on the tracked upstream.
echo "=== aibox repository ==="
if git -C "$SCRIPT_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$SCRIPT_DIR" fetch --quiet 2>/dev/null || echo "  (git fetch failed, using existing refs)"
    UPSTREAM=$(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo "")
    if [[ -n "$UPSTREAM" ]]; then
        BEHIND=$(git -C "$SCRIPT_DIR" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)
        if [[ "$BEHIND" -gt 0 ]]; then
            echo "  $BEHIND commit(s) behind $UPSTREAM (run 'aibox self-update')"
        else
            echo "  up to date"
        fi
    else
        echo "  no upstream configured"
    fi
else
    echo "  not a git checkout"
fi

if ! vm_exists "$VM_NAME" || [[ "$(vm_state "$VM_NAME")" != "running" ]]; then
    echo "Error: VM '$VM_NAME' is not running."
    exit 1
fi

vm_resolve "$VM_NAME"

echo ""
echo "=== VM updates ==="

# The check script ships with the repo: push it if the VM does not have it yet.
if ! vm_ssh -o ConnectTimeout=10 -- "test -f ~/scripts/update-check.sh" 2>/dev/null; then
    echo "Uploading update-check.sh to the VM..."
    vm_ssh -o ConnectTimeout=10 -- "mkdir -p ~/scripts"
    vm_scp "$SCRIPT_DIR/guest/update-check.sh" "$VM_SSH_TARGET:~/scripts/"
    vm_ssh -o ConnectTimeout=10 -- "chmod +x ~/scripts/update-check.sh"
fi

vm_ssh -o ConnectTimeout=10 -- "~/scripts/update-check.sh --print"
