#!/bin/bash
set -e

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SOURCE_LINK="$(readlink "$SCRIPT_SOURCE")"
    if [[ "$SOURCE_LINK" == /* ]]; then
        SCRIPT_SOURCE="$SOURCE_LINK"
    else
        SCRIPT_SOURCE="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)/$SOURCE_LINK"
    fi
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")/.." && pwd)"
CONFIG_FILE="$HOME/.config/aibox/aibox.conf"
source "$SCRIPT_DIR/shared-funcs.sh"
source "$SCRIPT_DIR/config-funcs.sh"
source "$SCRIPT_DIR/services-funcs.sh"
init_config_file
source "$SCRIPT_DIR/host/service.sh"
source "$SCRIPT_DIR/host/vm.sh"

VM_NAME=$(get_config "VM_NAME" "aibox")
GUEST_USER=$(get_config "GUEST_USER" "aibox")

usage() {
    echo "Usage: aibox tunnel <command> [options]"
    echo ""
    echo "Commands:"
    echo "  start                     Start the tunnel service"
    echo "  stop                      Stop the tunnel service (VM keeps running)"
    echo "  restart                   Restart the tunnel service"
    echo "  status [--json] [--tokens] Show tunnel state, URLs and per-service LAN modes"
    echo "  logs                      Show the last tunnel logs"
    echo "  lan on [SERVICE...]       Expose services on the LAN (temporary by default)"
    echo "  lan off [SERVICE...]      Back to localhost for the selected services (or all)"
    echo "  install                   Install the user service on the host"
    echo "  uninstall                 Remove the user service from the host"
    echo ""
    echo "Options for 'lan on':"
    echo "  --permanent               Persist the exposure in services.json (survives reboot)"
    echo "  --timeout DUR             Temporary duration (e.g. 30m, 2h); default: TUNNEL_LAN_TIMEOUT"
    echo "  --no-timeout              Temporary until the next reboot (no time limit)"
    echo "  -y, --yes                 Do not ask for confirmation"
    echo ""
    echo "  --permanent, --timeout and --no-timeout are mutually exclusive."
    echo ""
    echo "Options for 'status':"
    echo "  --json                    Machine-readable JSON"
    echo "  --tokens                  Include dsh/opencode authentication details"
    echo ""
    echo "Without SERVICE, 'lan on' and 'lan off' apply to every configured service."
    echo "Temporary exposure is always lost on reboot; permanent exposure is kept"
    echo "in services.json and applied again on the next 'aibox start'."
    echo ""
    echo "Examples:"
    echo "  aibox tunnel lan on dsh                    # temporary, 2h by default"
    echo "  aibox tunnel lan on dsh --timeout 30m"
    echo "  aibox tunnel lan on opencode --permanent    # survives reboot"
    echo "  aibox tunnel lan off opencode"
    echo "  aibox tunnel status"
}

duration_to_seconds() {
    local d="$1" value multiplier=1
    case "$d" in
        ""|"0") printf '%s\n' "0"; return 0 ;;
        *s) value="${d%s}" ;;
        *m) value="${d%m}"; multiplier=60 ;;
        *h) value="${d%h}"; multiplier=3600 ;;
        *) value="$d" ;;
    esac

    if [[ ! "$value" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$d"
        return 0
    fi
    printf '%s\n' "$(( value * multiplier ))"
}

format_epoch() {
    local epoch="$1"
    date -d "@$epoch" '+%Y-%m-%d %H:%M:%S' 2>/dev/null \
        || date -r "$epoch" '+%Y-%m-%d %H:%M:%S' 2>/dev/null \
        || printf '%s' "$epoch"
}

# The dsh-web URL embeds an authentication token that dsh generates at
# startup and only keeps in the journal (like the MOTD). Fetch it from the
# guest once, best effort.
DSH_GUEST_URL=""
DSH_GUEST_URL_LOADED=false

guest_dsh_url() {
    if [[ "$DSH_GUEST_URL_LOADED" == "true" ]]; then
        printf '%s' "$DSH_GUEST_URL"
        return 0
    fi
    DSH_GUEST_URL_LOADED=true

    [[ "$(vm_state "$VM_NAME")" == "running" ]] || return 0

    local ip
    ip=$(vm_ip "$VM_NAME")
    [[ -n "$ip" ]] || return 0

    # -n: never read stdin, or ssh would swallow the remaining lines of the
    # service list read by service_urls' while loop.
    DSH_GUEST_URL=$(ssh -n -o BatchMode=yes -o ConnectTimeout=5 "$GUEST_USER@$ip" \
        'journalctl --user -u dsh-web.service -n 500 --no-pager -o cat 2>/dev/null | tr -d "\033" | grep -oE "https?://[^[:space:]\"]+" | tail -n 1' 2>/dev/null || true)
    printf '%s' "$DSH_GUEST_URL"
}

# opencode serve generates its own password at startup (like dsh generates a
# token) and only prints it in the journal. Fetch it from the guest once.
OPENCODE_GUEST_PASSWORD=""
OPENCODE_GUEST_PASSWORD_LOADED=false

guest_opencode_password() {
    if [[ "$OPENCODE_GUEST_PASSWORD_LOADED" == "true" ]]; then
        printf '%s' "$OPENCODE_GUEST_PASSWORD"
        return 0
    fi
    OPENCODE_GUEST_PASSWORD_LOADED=true

    [[ "$(vm_state "$VM_NAME")" == "running" ]] || return 0

    local ip
    ip=$(vm_ip "$VM_NAME")
    [[ -n "$ip" ]] || return 0

    # Read the journal since the last service start so the key is found even
    # after a long run; fall back to the last 500 lines.
    # -n: never read stdin, or ssh would swallow the remaining lines of the
    # service list read by service_urls' while loop.
    OPENCODE_GUEST_PASSWORD=$(ssh -n -o BatchMode=yes -o ConnectTimeout=5 "$GUEST_USER@$ip" \
        'since=$(systemctl --user show -p ActiveEnterTimestamp --value opencode.service 2>/dev/null); if [ -n "$since" ]; then journalctl --user -u opencode.service --since "$since" --no-pager -o cat; else journalctl --user -u opencode.service -n 500 --no-pager -o cat; fi 2>/dev/null | tr -d "\033" | sed -nE "s/.*server password ([^[:space:]]+).*/\1/p" | tail -n 1' 2>/dev/null || true)
    printf '%s' "$OPENCODE_GUEST_PASSWORD"
}

# guest_dsh_suffix <guest_port>: path and query of the dsh-web URL when it
# listens on that guest port (e.g. "/?token=..."), empty otherwise.
guest_dsh_suffix() {
    local url
    url=$(guest_dsh_url)
    [[ -n "$url" ]] || return 0

    local url_port
    url_port=$(printf '%s' "$url" | sed -E 's#^https?://[^:/]+:([0-9]+).*#\1#')
    [[ "$url_port" == "$1" ]] || return 0

    printf '%s' "$url" | sed -E 's#^https?://[^/]+##'
}

# print_service_line <state> <name> <url> [extra]
# Prints one service line with its availability marker. The marker is printed
# directly (not through a command substitution) so the terminal detection
# still sees the real stdout.
print_service_line() {
    local state="$1" name="$2" url="$3" extra="${4:-}"

    printf '  '
    aibox_status_dot "$state"
    printf '%-14s %s%s' "$name" "$url" "$extra"
    aibox_status_text "$state"
    printf '\n'
}

service_urls() {
    local show_tokens="${1:-}"
    [[ -f "$SERVICES_FILE" ]] || return 0

    local name port host guest suffix auth mode until state_label
    local probe_guest_ip=""

    if [[ "$(vm_state "$VM_NAME")" == "running" ]]; then
        probe_guest_ip=$(vm_ip "$VM_NAME")
    fi
    probe_service_states "$probe_guest_ip"

    while IFS=$'\t' read -r name port; do
        [[ -z "$name" || -z "$port" ]] && continue
        host="${port%%:*}"
        guest="${port#*:}"
        suffix=""
        auth=""

        case "${PROBE_STATE[$guest]:-}" in
            up) state_label="up" ;;
            down) state_label="down" ;;
            *) state_label="unknown" ;;
        esac

        if [[ "$show_tokens" == "tokens" ]]; then
            suffix=$(guest_dsh_suffix "$guest")
            if [[ "$name" == "opencode" ]]; then
                local password
                password=$(guest_opencode_password)
                [[ -n "$password" ]] && auth="  (password: $password)"
            fi
        fi

        print_service_line "$state_label" "$name" "http://localhost:${host}${suffix}" "$auth"

        mode=$(service_effective_lan "$name")
        if [[ "$mode" == "permanent" ]]; then
            print_service_line "$state_label" "$name" \
                "http://$(host_local_name):${host}${suffix}  (LAN permanent)" "$auth"
        elif [[ "$mode" == "temporary" ]]; then
            until=$(service_lan_until "$name")
            if [[ "$until" =~ ^[0-9]+$ ]] && [[ "$until" -gt 0 ]]; then
                print_service_line "$state_label" "$name" \
                    "http://$(host_local_name):${host}${suffix}  (LAN temporary until $(format_epoch "$until"))" "$auth"
            else
                print_service_line "$state_label" "$name" \
                    "http://$(host_local_name):${host}${suffix}  (LAN temporary until reboot)" "$auth"
            fi
        fi
    done < <(services_entries)
}

# --- Service availability probe ---------------------------------------------
#
# The host port always accepts connections while the tunnel is up, even when
# the guest service is down, so the check has to run inside the VM: it tests
# whether the guest port is listening on 127.0.0.1. One SSH round trip covers
# every port. The result is cached for a few seconds because the web console
# polls the status regularly.

PROBE_CACHE_DIR="${XDG_RUNTIME_DIR:-$HOME/.cache}/aibox"
PROBE_CACHE_FILE="$PROBE_CACHE_DIR/service-probe.cache"
# The web console polls the status every few seconds: the probe result is
# cached to avoid one SSH round trip per poll.
PROBE_CACHE_TTL=10

file_mtime() {
    local mtime
    mtime=$(stat -c %Y "$1" 2>/dev/null) || mtime=$(stat -f %m "$1" 2>/dev/null) || mtime=0
    printf '%s\n' "$mtime"
}

# probe_cache_load <key>: prints the cached "<port> <up|down>" lines when the
# cache is fresh and was taken for the same key (guest IP and port list).
probe_cache_load() {
    local key="$1" now mtime cached_key
    [[ -f "$PROBE_CACHE_FILE" ]] || return 1
    now=$(date +%s)
    mtime=$(file_mtime "$PROBE_CACHE_FILE")
    [[ "$mtime" =~ ^[0-9]+$ ]] || return 1
    if (( now - mtime > PROBE_CACHE_TTL )); then
        return 1
    fi
    cached_key=$(head -n1 "$PROBE_CACHE_FILE" 2>/dev/null || true)
    [[ "$cached_key" == "$key" ]] || return 1
    tail -n +2 "$PROBE_CACHE_FILE"
}

# probe_cache_store <key> <probe output>
probe_cache_store() {
    local key="$1" output="$2"
    mkdir -p "$PROBE_CACHE_DIR" 2>/dev/null || return 0
    {
        printf '%s\n' "$key"
        printf '%s\n' "$output"
    } > "$PROBE_CACHE_FILE.tmp" 2>/dev/null || return 0
    mv -f "$PROBE_CACHE_FILE.tmp" "$PROBE_CACHE_FILE" 2>/dev/null || rm -f "$PROBE_CACHE_FILE.tmp"
    return 0
}

# guest_probe_ports <guest_ip> <port>...
# Prints one "<port> up" or "<port> down" line per port. Uses bash /dev/tcp in
# the guest so no extra tool is needed there.
guest_probe_ports() {
    local ip="$1"
    shift
    local ports=("$@")
    if [[ ${#ports[@]} -eq 0 ]]; then
        return 0
    fi
    if [[ -z "$ip" ]]; then
        return 1
    fi

    # The ports are passed as arguments: the heredoc stays unexpanded, so the
    # guest shell is the only one interpreting the loop.
    ssh -o BatchMode=yes -o ConnectTimeout=5 "$GUEST_USER@$ip" bash -s -- "${ports[@]}" <<'PROBE' 2>/dev/null
for p in "$@"; do
    if (exec 3<>/dev/tcp/127.0.0.1/"$p") 2>/dev/null; then
        echo "$p up"
    else
        echo "$p down"
    fi
done
PROBE
}

# probe_service_states <guest_ip>
# Fills the global PROBE_STATE array with "<guest port>" -> "up" | "down".
# The guest IP is empty when the VM is not running: nothing is probed then.
declare -A PROBE_STATE=()

probe_service_states() {
    local guest_ip="$1"
    local -a probe_ports=()
    local pname pport probe_port probe_state probe_key probe_output

    PROBE_STATE=()

    if [[ -z "$guest_ip" ]]; then
        return 0
    fi

    while IFS=$'\t' read -r pname pport; do
        [[ -n "$pname" && -n "$pport" ]] || continue
        probe_ports+=("${pport#*:}")
    done < <(services_entries)

    if [[ ${#probe_ports[@]} -eq 0 ]]; then
        return 0
    fi

    probe_key="$guest_ip ${probe_ports[*]}"
    probe_output=$(probe_cache_load "$probe_key" || true)
    if [[ -z "$probe_output" ]]; then
        probe_output=$(guest_probe_ports "$guest_ip" "${probe_ports[@]}" || true)
        if [[ -n "$probe_output" ]]; then
            probe_cache_store "$probe_key" "$probe_output"
        fi
    fi

    while read -r probe_port probe_state; do
        [[ -n "$probe_port" ]] || continue
        PROBE_STATE["$probe_port"]="$probe_state"
    done <<< "$probe_output"

    return 0
}

# tunnel_status_json [tokens]
# Machine-readable status for 'aibox status --json' and the web UI.
tunnel_status_json() {
    local include_tokens="${1:-false}"
    local vm_exists_json=false vm_state_value="unknown" guest_ip="" lan_host
    local tunnel_installed=false tunnel_active=false tunnel_status="unsupported"
    local permanent_count=0 temporary_count=0
    local name port host guest mode until until_json suffix password url_local url_lan
    local services_tmp services_json="[]"
    local port_open

    if vm_exists "$VM_NAME"; then
        vm_exists_json=true
        vm_state_value=$(vm_state "$VM_NAME")
        if [[ "$vm_state_value" == "running" ]]; then
            guest_ip=$(vm_ip "$VM_NAME")
        fi
    fi

    if svc_require >/dev/null 2>&1; then
        if svc_installed; then
            tunnel_installed=true
            tunnel_status=$(svc_status_text)
            if svc_is_active; then
                tunnel_active=true
            fi
        else
            tunnel_status="not installed"
        fi
    fi

    # Check which guest ports are listening (one SSH round trip for all).
    probe_service_states "$guest_ip"

    lan_host=$(host_local_name)
    services_tmp=$(mktemp) || return 1

    while IFS=$'\t' read -r name port; do
        [[ -n "$name" && -n "$port" ]] || continue

        host="${port%%:*}"
        guest="${port#*:}"
        mode=$(service_effective_lan "$name")
        suffix=""
        password=""

        if [[ "$include_tokens" == "true" ]]; then
            suffix=$(guest_dsh_suffix "$guest")
            if [[ "$name" == "opencode" ]]; then
                password=$(guest_opencode_password)
            fi
        fi

        url_local="http://localhost:${host}${suffix}"
        url_lan=""
        if [[ "$mode" != "local" ]]; then
            url_lan="http://${lan_host}:${host}${suffix}"
        fi

        until=$(service_lan_until "$name")
        if [[ "$until" =~ ^[0-9]+$ ]] && [[ "$until" -gt 0 ]]; then
            until_json="$until"
        else
            until_json="null"
        fi

        case "$mode" in
            permanent) permanent_count=$((permanent_count + 1)) ;;
            temporary) temporary_count=$((temporary_count + 1)) ;;
        esac

        # port_open: true when the guest port is listening, false when it is
        # closed, null when the state is unknown (VM off, probe failed).
        port_open="null"
        case "${PROBE_STATE[$guest]:-}" in
            up) port_open="true" ;;
            down) port_open="false" ;;
        esac

        jq -n \
            --arg name "$name" \
            --arg port "$port" \
            --arg host_port "$host" \
            --arg guest_port "$guest" \
            --arg lan "$mode" \
            --argjson until "$until_json" \
            --argjson port_open "$port_open" \
            --arg url_local "$url_local" \
            --arg url_lan "$url_lan" \
            --arg password "$password" \
            '{
                name: $name,
                port: $port,
                host_port: $host_port,
                guest_port: $guest_port,
                lan: $lan,
                until: $until,
                port_open: $port_open,
                url_local: $url_local,
                url_lan: (if $url_lan == "" then null else $url_lan end),
                password: (if $password == "" then null else $password end)
            }' >> "$services_tmp"
    done < <(services_entries)

    if [[ -s "$services_tmp" ]]; then
        services_json=$(jq -s '.' "$services_tmp")
    fi
    rm -f "$services_tmp"

    jq -n \
        --arg vm_name "$VM_NAME" \
        --argjson vm_exists "$vm_exists_json" \
        --arg vm_state "$vm_state_value" \
        --arg vm_ip "$guest_ip" \
        --argjson tunnel_installed "$tunnel_installed" \
        --argjson tunnel_active "$tunnel_active" \
        --arg tunnel_status "$tunnel_status" \
        --arg lan_hostname "$lan_host" \
        --arg lan_hostname_configured "$(get_config "LAN_HOSTNAME" "")" \
        --argjson permanent_count "$permanent_count" \
        --argjson temporary_count "$temporary_count" \
        --argjson services "$services_json" \
        '{
            vm: {
                name: $vm_name,
                exists: $vm_exists,
                running: ($vm_state == "running"),
                state: $vm_state,
                ip: (if $vm_ip == "" then null else $vm_ip end)
            },
            tunnel: {
                installed: $tunnel_installed,
                active: $tunnel_active,
                status: $tunnel_status
            },
            config: {
                lan_hostname: $lan_hostname,
                lan_hostname_configured: (if $lan_hostname_configured == "" then null else $lan_hostname_configured end)
            },
            lan: {
                permanent: $permanent_count,
                temporary: $temporary_count
            },
            services: $services
        }'
}

# svc_refresh applies config changes to the tunnel service. It starts the
# service when it is stopped (for example after a transient failure) and
# restarts it when it is already running. No-op when the VM is not running.
svc_refresh() {
    svc_require >/dev/null 2>&1 || return 0
    svc_installed || return 0
    [[ "$(vm_state "$VM_NAME")" == "running" ]] || return 0
    if svc_is_active; then
        svc_restart || true
    else
        svc_start || true
    fi
}

# Remove expired temporary exposures (including entries from a previous boot)
# and restart the tunnel when something actually changed.
enforce_lan_timeouts() {
    local expired name
    expired=$(lan_runtime_expired_names || true)
    [[ -n "$expired" ]] || return 0

    lan_runtime_prune
    svc_refresh

    while IFS= read -r name; do
        [[ -n "$name" ]] && print_info "LAN exposure expired: $name"
    done <<< "$expired"
}

# lan_security_warnings returns 1 when a selected service is exposed without
# authentication and the user should confirm.
lan_security_warnings() {
    local check_opencode=false check_vscode=false name

    for name in "$@"; do
        [[ "$name" == "opencode" ]] && check_opencode=true
        [[ "$name" == "vscode-server" ]] && check_vscode=true
    done

    # No known authentication check for the selected services.
    [[ "$check_opencode" == "true" || "$check_vscode" == "true" ]] || return 0

    if [[ "$(vm_state "$VM_NAME")" != "running" ]]; then
        print_info "VM not running: nothing is exposed until it starts."
        return 0
    fi

    local ip target
    ip=$(vm_ip "$VM_NAME")
    if [[ -z "$ip" ]]; then
        print_info "Guest IP unknown: skipping authentication checks."
        return 0
    fi
    target="$GUEST_USER@$ip"

    if ! ssh -o BatchMode=yes -o ConnectTimeout=5 "$target" true &>/dev/null; then
        print_info "VM not reachable over SSH: skipping authentication checks."
        return 0
    fi

    local warnings=0

    if [[ "$check_opencode" == "true" ]] \
        && ssh -o BatchMode=yes -o ConnectTimeout=5 "$target" \
            "systemctl --user is-active --quiet opencode.service" &>/dev/null; then
        # opencode v2 always generates a server password at startup.
        if [[ -n "$(guest_opencode_password)" ]]; then
            print_info "opencode: password protected."
        else
            print_warn "opencode: no server password detected; LAN exposure is unsafe."
            warnings=1
        fi
    fi

    if [[ "$check_vscode" == "true" ]] \
        && ssh -o BatchMode=yes -o ConnectTimeout=5 "$target" \
            "test -f ~/vscode-server/docker-compose.yml"; then
        if ssh -o BatchMode=yes -o ConnectTimeout=5 "$target" \
            "grep -q -- '--auth password' ~/vscode-server/docker-compose.yml && grep -q 'PASSWORD=.' ~/vscode-server/docker-compose.yml"; then
            print_info "vscode-server: password protected."
        else
            print_warn "vscode-server: password authentication not detected."
            warnings=1
        fi
    fi

    # dsh-web connection URLs embed an authentication token: no warning.
    return "$warnings"
}

lan_expire() {
    local name="$1" until="$2" current
    [[ "$until" =~ ^[0-9]+$ ]] || return 0

    current=$(lan_runtime_get_until "$name")
    [[ -n "$current" && "$current" == "$until" ]] || return 0
    [[ "$(date +%s)" -ge "$until" ]] || return 0

    lan_runtime_remove "$name"
    svc_refresh
    print_info "LAN exposure expired: $name"
}

svc_or_die() {
    svc_require
}

ACTION="${1:-}"
if [[ $# -gt 0 ]]; then
    shift
fi

# 'aibox tunnel <command> --help' shows the tunnel help.
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

case "$ACTION" in
    ""|help|-h|--help)
        usage
        exit 0
        ;;
    installed|install|uninstall|stop|restart|logs)
        # Fast paths that do not read services.json or the LAN state.
        ;;
    *)
        if ! services_require_jq; then
            exit 1
        fi
        services_migrate_legacy_global
        ;;
esac

case "$ACTION" in
    installed)
        if svc_require >/dev/null 2>&1 && svc_installed; then
            exit 0
        fi
        exit 1
        ;;

    install)
        svc_or_die
        svc_install
        print_success "Installed $SVC_UNIT_NAME"
        if [[ "$(vm_state "$VM_NAME")" == "running" ]]; then
            svc_start || true
            print_info "Tunnel service started (the VM is running)."
        else
            echo "The service is not started at login; run 'aibox start' when you need it."
        fi
        ;;

    uninstall)
        svc_or_die
        if svc_installed; then
            svc_uninstall
            print_success "Removed $SVC_UNIT_NAME"
        else
            print_info "Tunnel service is not installed."
        fi
        ;;

    start)
        svc_or_die
        enforce_lan_timeouts
        if ! svc_installed; then
            print_error "Tunnel service is not installed. Run 'aibox tunnel install' first."
            exit 1
        fi
        svc_start
        print_success "Tunnel service started."
        ;;

    stop)
        if svc_require >/dev/null 2>&1 && svc_installed; then
            svc_stop
            print_success "Tunnel service stopped (the VM keeps running)."
        else
            print_info "Tunnel service is not installed/running."
        fi
        ;;

    restart)
        svc_or_die
        if ! svc_installed; then
            print_error "Tunnel service is not installed. Run 'aibox tunnel install' first."
            exit 1
        fi
        svc_restart
        print_success "Tunnel service restarted."
        ;;

    # ensure: start the service only when it is not already running and the VM
    # is up. Used after 'aibox restart' so a self-healing tunnel is not killed.
    ensure)
        enforce_lan_timeouts
        if svc_require >/dev/null 2>&1 && svc_installed && ! svc_is_active; then
            if [[ "$(vm_state "$VM_NAME")" == "running" ]]; then
                svc_start || true
            fi
        fi
        ;;

    # reload: pick up service/port changes once the VM is up.
    reload)
        enforce_lan_timeouts
        svc_refresh
        ;;

    logs)
        svc_or_die
        if svc_installed; then
            svc_logs
        else
            print_info "Tunnel service is not installed."
        fi
        ;;

    status)
        STATUS_JSON=false
        STATUS_TOKENS=false
        for arg in "$@"; do
            case "$arg" in
                --json) STATUS_JSON=true ;;
                --tokens) STATUS_TOKENS=true ;;
                -h|--help) usage; exit 0 ;;
                *)
                    print_error "Unknown option for 'tunnel status': $arg"
                    exit 1
                    ;;
            esac
        done

        if [[ "$STATUS_JSON" == "true" ]]; then
            enforce_lan_timeouts >&2
            tunnel_status_json "$STATUS_TOKENS"
            exit 0
        fi

        enforce_lan_timeouts
        echo "Tunnel:"
        if [[ "$(vm_state "$VM_NAME")" == "running" ]]; then
            echo "  VM:       $VM_NAME (running)"
        elif vm_exists "$VM_NAME"; then
            echo "  VM:       $VM_NAME ($(vm_state "$VM_NAME"))"
        else
            echo "  VM:       $VM_NAME (not created)"
        fi

        if svc_require >/dev/null 2>&1; then
            if svc_installed; then
                echo "  Service:  $(svc_status_text)"
                if [[ "$(vm_state "$VM_NAME")" == "running" ]] && ! svc_is_active; then
                    echo "  Last logs:"
                    svc_logs 2>/dev/null | tail -3 | sed 's/^/    /' || true
                    echo "  Hint:     full logs: 'aibox tunnel logs'"
                fi
            else
                echo "  Service:  not installed (run: aibox tunnel install)"
            fi
        else
            echo "  Service:  unsupported on this platform"
        fi

        permanent_count=0
        temporary_count=0
        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            case "$(service_effective_lan "$name")" in
                permanent) permanent_count=$((permanent_count + 1)) ;;
                temporary) temporary_count=$((temporary_count + 1)) ;;
            esac
        done < <(service_names)
        if [[ $((permanent_count + temporary_count)) -gt 0 ]]; then
            echo "  LAN:      $permanent_count permanent, $temporary_count temporary"
        else
            echo "  LAN:      none"
        fi

        echo "  Services:"
        service_urls tokens
        ;;

    lan)
        SUBACTION="${1:-}"
        shift || true

        case "$SUBACTION" in
            on)
                TIMEOUT_OVERRIDE=""
                TIMEOUT_SET=false
                NO_TIMEOUT=false
                PERMANENT=false
                ASSUME_YES=false
                TARGETS=()

                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --permanent)
                            PERMANENT=true
                            shift
                            ;;
                        --timeout)
                            if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
                                print_error "--timeout requires a duration (e.g. 30m, 2h)."
                                exit 1
                            fi
                            TIMEOUT_OVERRIDE="$2"
                            TIMEOUT_SET=true
                            shift 2
                            ;;
                        --timeout=*)
                            TIMEOUT_OVERRIDE="${1#*=}"
                            if [[ -z "$TIMEOUT_OVERRIDE" ]]; then
                                print_error "--timeout requires a duration (e.g. 30m, 2h)."
                                exit 1
                            fi
                            TIMEOUT_SET=true
                            shift
                            ;;
                        --no-timeout)
                            NO_TIMEOUT=true
                            shift
                            ;;
                        -y|--yes)
                            ASSUME_YES=true
                            shift
                            ;;
                        -h|--help)
                            usage
                            exit 0
                            ;;
                        -*)
                            print_error "Unknown option: $1"
                            exit 1
                            ;;
                        *)
                            TARGETS+=("$1")
                            shift
                            ;;
                    esac
                done

                OPTION_COUNT=0
                [[ "$PERMANENT" == "true" ]] && OPTION_COUNT=$((OPTION_COUNT + 1))
                [[ "$TIMEOUT_SET" == "true" ]] && OPTION_COUNT=$((OPTION_COUNT + 1))
                [[ "$NO_TIMEOUT" == "true" ]] && OPTION_COUNT=$((OPTION_COUNT + 1))
                if [[ "$OPTION_COUNT" -gt 1 ]]; then
                    print_error "Use only one of --permanent, --timeout or --no-timeout."
                    exit 1
                fi

                enforce_lan_timeouts

                if [[ ${#TARGETS[@]} -eq 0 ]]; then
                    while IFS= read -r name; do
                        [[ -n "$name" ]] && TARGETS+=("$name")
                    done < <(service_names)
                fi

                if [[ ${#TARGETS[@]} -eq 0 ]]; then
                    print_error "No services configured. Add one with: aibox service-add <name> <port>"
                    exit 1
                fi

                for name in "${TARGETS[@]}"; do
                    if ! service_exists "$name"; then
                        print_error "Unknown service: $name"
                        print_info "Run 'aibox service-list' to see configured services."
                        exit 1
                    fi
                done

                TIMEOUT_S=0
                TIMEOUT_LABEL=""
                if [[ "$PERMANENT" != "true" ]]; then
                    if [[ "$NO_TIMEOUT" == "true" ]]; then
                        TIMEOUT_S=0
                    elif [[ "$TIMEOUT_SET" == "true" ]]; then
                        TIMEOUT_S="$(duration_to_seconds "$TIMEOUT_OVERRIDE")"
                        TIMEOUT_LABEL="$TIMEOUT_OVERRIDE"
                    else
                        TIMEOUT_LABEL="$(get_config "TUNNEL_LAN_TIMEOUT" "2h")"
                        TIMEOUT_S="$(duration_to_seconds "$TIMEOUT_LABEL")"
                    fi

                    if [[ ! "$TIMEOUT_S" =~ ^[0-9]+$ ]]; then
                        print_error "Invalid timeout: ${TIMEOUT_OVERRIDE:-$TIMEOUT_LABEL}"
                        exit 1
                    fi
                fi

                if ! lan_security_warnings "${TARGETS[@]}"; then
                    if [[ "$ASSUME_YES" != "true" ]]; then
                        if [[ -t 0 ]]; then
                            if [[ "$PERMANENT" == "true" ]]; then
                                prompt="Expose these services permanently on the LAN anyway?"
                            else
                                prompt="Expose these services on the LAN anyway?"
                            fi
                            if ! prompt_yes_no "$prompt" "no"; then
                                print_info "Cancelled."
                                exit 0
                            fi
                        else
                            print_error "Refusing to expose services on the LAN unattended; use --yes."
                            exit 1
                        fi
                    fi
                fi

                UNTIL=0
                if [[ "$PERMANENT" != "true" ]] && [[ "$TIMEOUT_S" -gt 0 ]]; then
                    UNTIL=$(( $(date +%s) + TIMEOUT_S ))
                fi

                CHANGED=0
                for name in "${TARGETS[@]}"; do
                    if [[ "$PERMANENT" == "true" ]]; then
                        service_set_lan "$name" "permanent"
                        lan_runtime_remove "$name"
                        CHANGED=1
                    else
                        if service_is_permanent "$name"; then
                            print_info "$name is already permanently exposed; use 'aibox tunnel lan off $name' first."
                            continue
                        fi
                        lan_runtime_set "$name" "$UNTIL"
                        CHANGED=1
                    fi
                done

                if [[ "$CHANGED" -eq 0 ]]; then
                    print_info "No LAN exposure changed."
                    exit 0
                fi

                if svc_require >/dev/null 2>&1 && svc_installed; then
                    svc_refresh
                else
                    print_info "Tunnel service not installed; mode saved and will apply once installed."
                fi

                if [[ "$PERMANENT" == "true" ]]; then
                    print_success "Services permanently exposed on the LAN (survives reboot)."
                elif [[ "$TIMEOUT_S" -gt 0 ]]; then
                    print_success "Services temporarily exposed on the LAN."
                    print_info "Automatic revert to localhost in $TIMEOUT_LABEL."
                else
                    print_success "Services temporarily exposed on the LAN."
                    print_info "Temporary exposure ends at the next reboot."
                fi
                service_urls
                ;;

            off)
                TARGETS=()
                ALL_SERVICES=false
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        -h|--help)
                            usage
                            exit 0
                            ;;
                        -*)
                            print_error "Unknown option: $1"
                            exit 1
                            ;;
                        *)
                            TARGETS+=("$1")
                            shift
                            ;;
                    esac
                done

                enforce_lan_timeouts

                if [[ ${#TARGETS[@]} -eq 0 ]]; then
                    ALL_SERVICES=true
                    while IFS= read -r name; do
                        [[ -n "$name" ]] && TARGETS+=("$name")
                    done < <(service_names)
                fi

                if [[ ${#TARGETS[@]} -eq 0 ]]; then
                    lan_runtime_clear || true
                    save_config "TUNNEL_BIND" "local"
                    save_config "TUNNEL_LAN_UNTIL" "0"
                    print_info "No services configured; LAN exposure cleared."
                    exit 0
                fi

                for name in "${TARGETS[@]}"; do
                    if ! service_exists "$name"; then
                        print_error "Unknown service: $name"
                        print_info "Run 'aibox service-list' to see configured services."
                        exit 1
                    fi
                done

                for name in "${TARGETS[@]}"; do
                    service_set_lan "$name" "local"
                    lan_runtime_remove "$name"
                done
                [[ "$ALL_SERVICES" == "true" ]] && lan_runtime_clear

                svc_refresh
                print_success "LAN exposure disabled for: ${TARGETS[*]}"
                service_urls
                ;;

            # Internal: remove expired entries (used by the login-time check).
            prune)
                enforce_lan_timeouts
                ;;

            # Internal: invoked by the per-service timer.
            expire)
                if [[ $# -lt 2 ]]; then
                    print_error "Usage: aibox tunnel lan expire <service> <until>"
                    exit 1
                fi
                lan_expire "$1" "$2"
                ;;

            ""|help|-h|--help)
                usage
                ;;

            *)
                print_error "Unknown lan command: $SUBACTION"
                echo "Run 'aibox tunnel help' for usage." >&2
                exit 1
                ;;
        esac
        ;;

    *)
        print_error "Unknown tunnel command: $ACTION"
        echo "Run 'aibox tunnel help' for usage." >&2
        exit 1
        ;;
esac
