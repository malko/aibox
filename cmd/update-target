#!/bin/bash
set -e

usage_update() {
    echo "Usage: aibox update <target> [<target> ...] [options]"
    echo ""
    echo "Update one or more components inside the VM (or the aibox scripts on the VM)."
    echo ""
    echo "Targets:"
    echo "  scripts            Re-upload the aibox scripts to the VM"
    echo "  opencode           Update the opencode CLI"
    echo "  opencode-service   Reinstall the opencode server service"
    echo "  dsh                Update dsh and its web service"
    echo "  claude             Update Claude Code"
    echo "  vscode-server      Pull and restart vscode-server"
    echo "  os                 Update the VM OS packages"
    echo "  all                Run scripts, os, opencode, dsh, claude, vscode-server"
    echo ""
    echo "Several targets can be given: they run in the order listed, duplicates"
    echo "are ignored and the update stops at the first failure."
    echo ""
    echo "Options:"
    echo "  -y, --yes          Non-interactive system upgrade (os/all)"
    echo "  -h, --help         Show this help"
    echo ""
    echo "Examples:"
    echo "  aibox update opencode dsh"
    echo "  aibox update scripts os -y"
    echo "  aibox update all -y"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage_update
    exit 0
fi

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SOURCE_LINK="$(readlink "$SCRIPT_SOURCE")"
    if [[ "$SOURCE_LINK" == /* ]]; then
        SCRIPT_SOURCE="$SOURCE_LINK"
    else
        SCRIPT_SOURCE="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)/$SOURCE_LINK"
    fi
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")/.." && pwd)"
CONFIG_FILE="$HOME/.config/aibox/aibox.conf"
source "$SCRIPT_DIR/shared-funcs.sh"
source "$SCRIPT_DIR/config-funcs.sh"
init_config_file
source "$SCRIPT_DIR/host/backend.sh"

if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
fi

# Internal options used by the 'aibox' dispatcher, plus the public ones.
# Anything else starting with '-' is forwarded to the guest update script
# (for example the arguments accepted by 'opencode-service').
TARGETS=()
EXTRA_ARGS=()
VM_NAME=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage_update
            exit 0
            ;;
        --vm)
            if [[ -z "${2:-}" ]]; then
                echo "Error: --vm requires a VM name" >&2
                exit 1
            fi
            VM_NAME="$2"
            shift 2
            ;;
        -*)
            EXTRA_ARGS+=("$1")
            shift
            ;;
        *)
            TARGETS+=("$1")
            shift
            ;;
    esac
done

VM_NAME=${VM_NAME:-$(get_config "VM_NAME" "aibox")}

ALL_TARGETS=(scripts os opencode opencode-service dsh claude vscode-server)
ALL_EXPANSION=(scripts os opencode dsh claude vscode-server)

if [[ ${#TARGETS[@]} -eq 0 ]]; then
    echo "Missing target"
    echo "Targets: ${ALL_TARGETS[*]}, all"
    exit 1
fi

is_valid_target() {
    local candidate="$1" known
    for known in "${ALL_TARGETS[@]}"; do
        if [[ "$candidate" == "$known" ]]; then
            return 0
        fi
    done
    return 1
}

# Expand 'all' and drop duplicates while keeping the requested order.
RUN_TARGETS=()
declare -A SEEN_TARGETS=()
for target in "${TARGETS[@]}"; do
    if [[ "$target" == "all" ]]; then
        candidates=("${ALL_EXPANSION[@]}")
    else
        candidates=("$target")
    fi

    for candidate in "${candidates[@]}"; do
        if ! is_valid_target "$candidate"; then
            echo "Unknown target: $candidate" >&2
            echo "Available targets: ${ALL_TARGETS[*]}, all" >&2
            exit 1
        fi
        if [[ -z "${SEEN_TARGETS[$candidate]:-}" ]]; then
            SEEN_TARGETS[$candidate]=1
            RUN_TARGETS+=("$candidate")
        fi
    done
done

# The web job runner feeds the guest sudo password on stdin, in memory only.
# An interactive CLI has no piped stdin and keeps the usual sudo prompt.
SUDO_PASSWORD=""
if [[ "${AIBOX_WEB_JOB:-0}" == "1" ]]; then
    IFS= read -r SUDO_PASSWORD || true
fi

if ! vm_exists "$VM_NAME" || [[ "$(vm_state "$VM_NAME")" != "running" ]]; then
    echo "Error: VM '$VM_NAME' is not running."
    exit 1
fi

vm_resolve "$VM_NAME"

run_target() {
    local target="$1"
    local remote_extra=""
    local arg

    for arg in "${EXTRA_ARGS[@]}"; do
        remote_extra+=" $(printf '%q' "$arg")"
    done

    if [[ "$target" == "scripts" ]]; then
        echo "Updating scripts on VM..."
        "$SCRIPT_DIR/host/upload-scripts.sh" "$VM_NAME"
        return
    fi

    echo "connecting to aibox..."

    # Make sure the guest OS update script and its sudo helper are current,
    # even when the user has not run 'aibox update scripts' since the last
    # host update.
    if [[ "$target" == "os" ]]; then
        vm_scp -q -o ConnectTimeout=10 \
            "$SCRIPT_DIR/guest/update-target.sh" \
            "$SCRIPT_DIR/guest/sudo-funcs.sh" \
            "$VM_SSH_TARGET:~/scripts/" 2>/dev/null || true
    fi

    # The web UI has no terminal: feed the guest sudo password on stdin and
    # use 'sudo -S' inside the guest. The CLI keeps the interactive SSH path.
    # Run the script with bash explicitly: the remote login shell may be zsh
    # or dash, where BASH_SOURCE is unset and sourcing would resolve the
    # helper path from the wrong directory.
    if [[ "$target" == "os" && -n "$SUDO_PASSWORD" ]]; then
        printf '%s\n' "$SUDO_PASSWORD" | \
            vm_ssh -T -o ConnectTimeout=10 -- \
                "IFS= read -r SUDO_PASSWORD; export SUDO_PASSWORD; exec bash \"\$HOME/scripts/update-target.sh\" os${remote_extra}"
    else
        vm_ssh -t -o ConnectTimeout=10 -- \
            "\"\$HOME/scripts/update-target.sh\" $(printf '%q' "$target")${remote_extra}"
    fi
}

for target in "${RUN_TARGETS[@]}"; do
    if [[ ${#RUN_TARGETS[@]} -gt 1 ]]; then
        echo ""
        echo "=== Updating: $target ==="
    fi
    run_target "$target" || { echo "Update failed: $target" >&2; exit 1; }
done

if [[ ${#RUN_TARGETS[@]} -gt 1 ]]; then
    echo ""
    echo "All updates completed."
fi
